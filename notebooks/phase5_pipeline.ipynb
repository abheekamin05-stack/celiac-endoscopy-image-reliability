    "from pathlib import Path\n",
    "\n",
    "search_roots = [\n",
    "    Path(\"/content\"),\n",
    "    Path(\"/content/drive/MyDrive\"),\n",
    "]\n",
    "\n",
    "keywords = (\"celiac\", \"reliability\", \"milestone\", \"endoscopy\")\n",
    "\n",
    "for root in search_roots:\n",
    "    print(f\"\\nSearching: {root}\")\n",
    "\n",
    "    if not root.exists():\n",
    "        print(\"  Not available\")\n",
    "        continue\n",
    "\n",
    "    matches = [\n",
    "        path for path in root.rglob(\"*\")\n",
    "        if path.is_dir() and any(word in path.name.lower() for word in keywords)\n",
    "    ]\n",
    "\n",
    "    if matches:\n",
    "        for path in matches[:50]:\n",
    "            print(\" \", path)\n",
    "    else:\n",
    "        print(\"  No matching folders found\")"
