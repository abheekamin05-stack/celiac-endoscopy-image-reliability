  "cell_type": "code",
  "source": [
    "# Build the final Phase 5 report and an updated one-page mentor brief.\n",
    "\n",
    "from pathlib import Path\n",
    "import json\n",
    "import math\n",
    "\n",
    "import pandas as pd\n",
    "from pypdf import PdfReader\n",
    "from reportlab.lib import colors\n",
    "from reportlab.lib.enums import TA_CENTER, TA_LEFT\n",
    "from reportlab.lib.pagesizes import letter\n",
    "from reportlab.lib.styles import getSampleStyleSheet, ParagraphStyle\n",
    "from reportlab.lib.units import inch\n",
    "from reportlab.platypus import (\n",
    "    SimpleDocTemplate, Paragraph, Spacer, Table, TableStyle, PageBreak\n",
    ")\n",
    "\n",
    "WORK = Path(\"/content/celiac_reliability_phase5\")\n",
    "\n",
    "comparison = pd.read_csv(\n",
    "    WORK / \"phase5_review_ranking_comparison_table.csv\"\n",
    ")\n",
    "ablations = pd.read_csv(\n",
    "    WORK / \"phase5_primary_20pct_ablation_table.csv\"\n",
    ")\n",
    "events = pd.read_csv(\n",
    "    WORK / \"phase5_all_false_normal_events.csv\"\n",
    ")\n",
    "bootstrap = pd.read_csv(\n",
    "    WORK / \"group_resampled_bootstrap_primary_summary.csv\"\n",
    ").iloc[0].to_dict()\n",
    "\n",
    "crop = json.loads(\n",
    "    (WORK / \"central_field_crop_sensitivity_results.json\").read_text()\n",
    ")\n",
    "\n",
    "manifest = json.loads(\n",
    "    (WORK / \"phase5_completion_manifest.json\").read_text()\n",
    ")\n",
    "\n",
    "assert all(manifest[\"required_output_files_present\"].values())\n",
    "\n",
    "REPORT_PATH = WORK / \"Phase5_Celiac_Image_Reliability_Results.pdf\"\n",
    "BRIEF_PATH = WORK / \"Celiac_Endoscopy_AI_Mentor_Brief_Updated.pdf\"\n",
    "\n",
    "styles = getSampleStyleSheet()\n",
    "\n",
    "styles.add(ParagraphStyle(\n",
    "    name=\"ReportTitle\",\n",
    "    parent=styles[\"Title\"],\n",
    "    alignment=TA_CENTER,\n",
    "    fontName=\"Helvetica-Bold\",\n",
    "    fontSize=18,\n",
    "    leading=22,\n",
    "    spaceAfter=8,\n",
    "))\n",
    "\n",
    "styles.add(ParagraphStyle(\n",
    "    name=\"Subtitle\",\n",
    "    parent=styles[\"Normal\"],\n",
    "    alignment=TA_CENTER,\n",
    "    fontSize=9,\n",
    "    textColor=colors.HexColor(\"#555555\"),\n",
    "    spaceAfter=16,\n",
    "))\n",
    "\n",
    "styles.add(ParagraphStyle(\n",
    "    name=\"Section\",\n",
    "    parent=styles[\"Heading2\"],\n",
    "    fontName=\"Helvetica-Bold\",\n",
    "    fontSize=12,\n",
    "    leading=15,\n",
    "    textColor=colors.HexColor(\"#183B5B\"),\n",
    "    spaceBefore=10,\n",
    "    spaceAfter=6,\n",
    "))\n",
    "\n",
    "styles.add(ParagraphStyle(\n",
    "    name=\"BodySmall\",\n",
    "    parent=styles[\"BodyText\"],\n",
    "    fontSize=9.5,\n",
    "    leading=13,\n",
    "    spaceAfter=7,\n",
    "))\n",
    "\n",
    "styles.add(ParagraphStyle(\n",
    "    name=\"TableText\",\n",
    "    parent=styles[\"BodyText\"],\n",
    "    fontSize=7.5,\n",
    "    leading=9,\n",
    "))\n",
    "\n",
    "def paragraph(text, style=\"BodySmall\"):\n",
    "    return Paragraph(text, styles[style])\n",
    "\n",
    "def clean_number(value, digits=3):\n",
    "    if pd.isna(value):\n",
    "        return \"—\"\n",
    "    return f\"{float(value):.{digits}f}\"\n",
    "\n",
    "def percent(value, digits=1):\n",
    "    if pd.isna(value):\n",
    "        return \"—\"\n",
    "    return f\"{100 * float(value):.{digits}f}%\"\n",
    "\n",
    "def make_table(data, widths=None, header=True):\n",
    "    table = Table(data, colWidths=widths, repeatRows=1 if header else 0)\n",
    "    style = [\n",
    "        (\"GRID\", (0, 0), (-1, -1), 0.35, colors.HexColor(\"#B8C2CC\")),\n",
    "        (\"VALIGN\", (0, 0), (-1, -1), \"MIDDLE\"),\n",
    "        (\"LEFTPADDING\", (0, 0), (-1, -1), 5),\n",
    "        (\"RIGHTPADDING\", (0, 0), (-1, -1), 5),\n",
    "        (\"TOPPADDING\", (0, 0), (-1, -1), 4),\n",
    "        (\"BOTTOMPADDING\", (0, 0), (-1, -1), 4),\n",
    "    ]\n",
    "    if header:\n",
    "        style.extend([\n",
    "            (\"BACKGROUND\", (0, 0), (-1, 0), colors.HexColor(\"#183B5B\")),\n",
    "            (\"TEXTCOLOR\", (0, 0), (-1, 0), colors.white),\n",
    "            (\"FONTNAME\", (0, 0), (-1, 0), \"Helvetica-Bold\"),\n",
    "        ])\n",
    "    table.setStyle(TableStyle(style))\n",
    "    return table\n",
    "\n",
    "def page_footer(canvas, doc):\n",
    "    canvas.saveState()\n",
    "    canvas.setFont(\"Helvetica\", 8)\n",
    "    canvas.setFillColor(colors.HexColor(\"#666666\"))\n",
    "    canvas.drawString(\n",
    "        0.65 * inch,\n",
    "        0.42 * inch,\n",
    "        \"Celiac duodenal endoscopy image-label reliability study | Phase 5\"\n",
    "    )\n",
    "    canvas.drawRightString(\n",
    "        7.85 * inch,\n",
    "        0.42 * inch,\n",
    "        f\"Page {doc.page}\"\n",
    "    )\n",
    "    canvas.restoreState()\n",
    "\n",
    "# Build tables from actual frozen files.\n",
    "comparison_rows = [[\n",
    "    paragraph(\"Review rate\", \"TableText\"),\n",
    "    paragraph(\"Method\", \"TableText\"),\n",
    "    paragraph(\"K\", \"TableText\"),\n",
    "    paragraph(\"Events caught\", \"TableText\"),\n",
    "    paragraph(\"Capture among F\", \"TableText\"),\n",
    "    paragraph(\"Normal alerts\", \"TableText\"),\n",
    "    paragraph(\"Unflagged events\", \"TableText\"),\n",
    "]]\n",
    "\n",
    "for _, row in comparison.iterrows():\n",
    "    comparison_rows.append([\n",
    "        paragraph(percent(row[\"requested_review_rate\"], 0), \"TableText\"),\n",
    "        paragraph(str(row[\"method\"]), \"TableText\"),\n",
    "        paragraph(str(int(row[\"K_flagged\"])), \"TableText\"),\n",
    "        paragraph(str(int(row[\"target_events_caught\"])), \"TableText\"),\n",
    "        paragraph(percent(row[\"capture_among_F\"], 1), \"TableText\"),\n",
    "        paragraph(str(int(row[\"normal_alerts\"])), \"TableText\"),\n",
    "        paragraph(str(int(row[\"target_events_left_unflagged\"])), \"TableText\"),\n",
    "    ])\n",
    "\n",
    "ablation_rows = [[\n",
    "    paragraph(\"20% ranking\", \"TableText\"),\n",
    "    paragraph(\"Events caught\", \"TableText\"),\n",
    "    paragraph(\"Capture among F\", \"TableText\"),\n",
    "    paragraph(\"Normal alerts\", \"TableText\"),\n",
    "]]\n",
    "\n",
    "for _, row in ablations.iterrows():\n",
    "    ablation_rows.append([\n",
    "        paragraph(str(row[\"method\"]), \"TableText\"),\n",
    "        paragraph(str(int(row[\"target_events_caught\"])), \"TableText\"),\n",
    "        paragraph(percent(row[\"capture_among_F\"], 1), \"TableText\"),\n",
    "        paragraph(str(int(row[\"normal_alerts\"])), \"TableText\"),\n",
    "    ])\n",
    "\n",
    "primary_difference = int(\n",
    "    manifest[\"primary_paired_difference_combined_minus_confidence\"]\n",
    ")\n",
    "\n",
    "crop_primary = crop[\"comparisons\"][\"0.2\"]\n",
    "crop_confusion = crop[\"confusion_counts\"]\n",
    "\n",
    "event_filename_text = \", \".join(\n",
    "    events[\"file_id\"].sort_values().tolist()\n",
    ")\n",
    "\n",
    "# ---- Full report ----\n",
    "story = [\n",
    "    paragraph(\n",
    "        \"Phase 5 Results: Image-Label Reliability Study\",\n",
    "        \"ReportTitle\",\n",
    "    ),\n",
    "    paragraph(\n",
    "        \"Abheek Amin | Frozen protocol v1.0, dated 20 September 2026\",\n",
    "        \"Subtitle\",\n",
    "    ),\n",
    "\n",
    "    paragraph(\"Question and scope\", \"Section\"),\n",
    "    paragraph(\n",
    "        \"Among held-out images a classifier predicted Normal, would a fixed \"\n",
    "        \"equal-weight score combining weak Normal confidence, prediction \"\n",
    "        \"instability, and technical-quality proxies identify more \"\n",
    "        \"Celiac-labeled images than weak confidence alone at the same \"\n",
    "        \"review rate? The unit of analysis was a distinct supplied image, \"\n",
    "        \"not a patient or clinical diagnosis.\",\n",
    "    ),\n",
    "\n",
    "    paragraph(\"Dataset and model\", \"Section\"),\n",
    "    paragraph(\n",
    "        \"The analysis used 159 audited canonical images: 84 supplied Normal \"\n",
    "        \"and 75 supplied Celiac. Exact duplicates were removed, Doubtful \"\n",
    "        \"images were excluded, and known visually related pairs were kept \"\n",
    "        \"within the same one of five fixed outer folds. ImageNet-pretrained \"\n",
    "        \"ResNet-18 models produced one held-out prediction per image.\",\n",
    "    ),\n",
    "\n",
    "    paragraph(\"Primary result\", \"Section\"),\n",
    "    paragraph(\n",
    "        f\"Of {manifest['primary_population_N_predicted_normal']} \"\n",
    "        \"classifier-predicted Normal images, \"\n",
    "        f\"{manifest['primary_target_events_F_celiac_labeled']} had supplied \"\n",
    "        \"Celiac labels. At the prespecified 20% review rate \"\n",
    "        f\"(K = {manifest['primary_K_20pct']}), confidence-only ranking \"\n",
    "        f\"identified {manifest['primary_confidence_events_caught']} target \"\n",
    "        \"events; the equal-weight combined score identified \"\n",
    "        f\"{manifest['primary_combined_events_caught']}. The paired \"\n",
    "        f\"difference, combined minus confidence, was {primary_difference}. \"\n",
    "        \"The directional hypothesis was not supported.\",\n",
    "    ),\n",
    "\n",
    "    make_table(\n",
    "        comparison_rows,\n",
    "        widths=[0.63 * inch, 1.5 * inch, 0.38 * inch, 0.78 * inch,\n",
    "                0.8 * inch, 0.7 * inch, 0.85 * inch],\n",
    "    ),\n",
    "\n",
    "    paragraph(\"Prespecified 20% ablations\", \"Section\"),\n",
    "    make_table(\n",
    "        ablation_rows,\n",
    "        widths=[2.3 * inch, 0.9 * inch, 1.05 * inch, 0.9 * inch],\n",
    "    ),\n",
    "\n",
    "    paragraph(\"Conditional uncertainty\", \"Section\"),\n",
    "    paragraph(\n",
    "        \"Using 2,000 group-resampled bootstrap draws of the frozen \"\n",
    "        \"predictions, the 95% percentile interval for the primary paired \"\n",
    "        \"difference was \"\n",
    "        f\"{clean_number(bootstrap['bootstrap_percentile_95pct_ci_low'], 1)} \"\n",
    "        \"to \"\n",
    "        f\"{clean_number(bootstrap['bootstrap_percentile_95pct_ci_high'], 1)}. \"\n",
    "        f\"Confidence-only was better in \"\n",
    "        f\"{percent(bootstrap['fraction_resamples_confidence_better'], 1)} \"\n",
    "        \"of resamples, the rankings tied in \"\n",
    "        f\"{percent(bootstrap['fraction_resamples_equal'], 1)}, and the \"\n",
    "        \"combined score was better in \"\n",
    "        f\"{percent(bootstrap['fraction_resamples_combined_better'], 1)}. \"\n",
    "        \"This interval is conditional on this dataset and the trained models.\",\n",
    "    ),\n",
    "\n",
    "    paragraph(\"Central-field crop sensitivity analysis\", \"Section\"),\n",
    "    paragraph(\n",
    "        \"A second five-fold pipeline used only the central 80% of image \"\n",
    "        \"width and 70% of image height before resizing. This reduced \"\n",
    "        \"Celiac-labeled false normals from 14 to \"\n",
    "        f\"{crop['celiac_labeled_among_predicted_normal']} and changed \"\n",
    "        \"image-label sensitivity from \"\n",
    "        f\"{percent(manifest['full_image_sensitivity'], 1)} to \"\n",
    "        f\"{percent(crop['sensitivity'], 1)}. At the crop model's 20% review \"\n",
    "        f\"rate (K = {crop_primary['K']}), confidence-only and combined \"\n",
    "        f\"ranking each identified {crop_primary['confidence_only']['target_events_caught']} \"\n",
    "        \"target events. This sensitivity analysis does not replace the \"\n",
    "        \"full-image primary result.\",\n",
    "    ),\n",
    "\n",
    "    paragraph(\"Quality and layout diagnostics\", \"Section\"),\n",
    "    paragraph(\n",
    "        \"An exploratory AI-assisted, non-expert visual rating of 30 \"\n",
    "        \"anonymous images aligned with the automated exposure proxy, but \"\n",
    "        \"not with the blur proxy, glare proxy, or their full composite. \"\n",
    "        \"Quality distributions and error rates also varied across audited \"\n",
    "        \"layout categories. These categories were not balanced across the \"\n",
    "        \"supplied labels, so technical-quality and layout signals may act \"\n",
    "        \"as acquisition or source proxies rather than clinically meaningful \"\n",
    "        \"image difficulty measures.\",\n",
    "    ),\n",
    "\n",
    "    paragraph(\"Interpretation and limits\", \"Section\"),\n",
    "    paragraph(\n",
    "        \"The study shows that, in this small supplied-image dataset and \"\n",
    "        \"frozen model setup, confidence-only review ranking outperformed \"\n",
    "        \"the proposed combined score at the prespecified primary review \"\n",
    "        \"rate. The archive provides no patient IDs, biopsy results, \"\n",
    "        \"serology, Marsh grade, or per-image device metadata. Related \"\n",
    "        \"frames may still come from unknown shared encounters; labels, \"\n",
    "        \"layout styles, and quality measurements may be confounded. These \"\n",
    "        \"results do not establish celiac diagnosis from endoscopy, clinical \"\n",
    "        \"safety, or a replacement for specialist review, serology, or biopsy.\",\n",
    "    ),\n",
    "\n",
    "    PageBreak(),\n",
    "\n",
    "    paragraph(\"Appendix: Celiac-labeled false-normal filenames\", \"Section\"),\n",
    "    paragraph(\n",
    "        \"These are supplied archive filenames for the 14 target events in \"\n",
    "        \"the full-image primary analysis. They are image-file identifiers, \"\n",
    "        \"not patient identifiers.\",\n",
    "    ),\n",
    "    paragraph(event_filename_text),\n",
    "\n",
    "    paragraph(\"Frozen output inventory\", \"Section\"),\n",
    "    paragraph(\n",
    "        \"The project folder contains fold assignments, out-of-fold \"\n",
    "        \"predictions, reliability features, review scores, primary and crop \"\n",
    "        \"results, bootstrap results, visibility-check files, layout and \"\n",
    "        \"quality diagnostics, selected-set membership, and the completion \"\n",
    "        \"manifest. All required output files were present at closeout.\",\n",
    "    ),\n",
    "]\n",
    "\n",
    "document = SimpleDocTemplate(\n",
    "    str(REPORT_PATH),\n",
    "    pagesize=letter,\n",
    "    rightMargin=0.6 * inch,\n",
    "    leftMargin=0.6 * inch,\n",
    "    topMargin=0.62 * inch,\n",
    "    bottomMargin=0.65 * inch,\n",
    ")\n",
    "\n",
    "document.build(\n",
    "    story,\n",
    "    onFirstPage=page_footer,\n",
    "    onLaterPages=page_footer,\n",
    ")\n",
    "\n",
    "# ---- One-page mentor brief ----\n",
    "brief_story = [\n",
    "    paragraph(\n",
    "        \"Mentor Brief: Celiac Endoscopy Image-Label Reliability Study\",\n",
    "        \"ReportTitle\",\n",
    "    ),\n",
    "    paragraph(\n",
    "        \"Abheek Amin | Updated after Phase 5 analysis\",\n",
    "        \"Subtitle\",\n",
    "    ),\n",
    "\n",
    "    paragraph(\"Purpose\", \"Section\"),\n",
    "    paragraph(\n",
    "        \"I am seeking methodological feedback on a small, prespecified \"\n",
    "        \"study of whether uncertainty-style signals can prioritize \"\n",
    "        \"Celiac-labeled images among images a classifier predicts Normal.\",\n",
    "    ),\n",
    "\n",
    "    paragraph(\"What I did\", \"Section\"),\n",
    "    paragraph(\n",
    "        \"I audited a supplied archive, removed exact duplicate copies, set \"\n",
    "        \"Doubtful images aside, and created five fixed group-disjoint \"\n",
    "        \"outer folds for 159 canonical images (84 supplied Normal, 75 \"\n",
    "        \"supplied Celiac). I trained one ImageNet-pretrained ResNet-18 per \"\n",
    "        \"fold and pooled one held-out prediction per image. The fixed \"\n",
    "        \"primary comparison ranked predicted-Normal images by either weak \"\n",
    "        \"Normal confidence alone or an equal-weight combination of weak \"\n",
    "        \"confidence, transformation instability, and technical-quality \"\n",
    "        \"proxies.\",\n",
    "    ),\n",
    "\n",
    "    paragraph(\"Result\", \"Section\"),\n",
    "    paragraph(\n",
    "        f\"Among 86 predicted-Normal images, 14 had supplied Celiac labels. \"\n",
    "        f\"At a 20% review rate (18 images), confidence-only flagged \"\n",
    "        f\"{manifest['primary_confidence_events_caught']} target events and \"\n",
    "        f\"the combined score flagged \"\n",
    "        f\"{manifest['primary_combined_events_caught']} \"\n",
    "        f\"(difference {primary_difference}; group-bootstrap 95% interval \"\n",
    "        f\"{clean_number(bootstrap['bootstrap_percentile_95pct_ci_low'], 1)} \"\n",
    "        \"to \"\n",
    "        f\"{clean_number(bootstrap['bootstrap_percentile_95pct_ci_high'], 1)}). \"\n",
    "        \"The proposed score therefore did not outperform confidence alone.\",\n",
    "    ),\n",
    "\n",
    "    paragraph(\"Important limitations and questions for a mentor\", \"Section\"),\n",
    "    paragraph(\n",
    "        \"A central-field crop improved image-label sensitivity but produced \"\n",
    "        \"a 20% ranking tie, not a primary-score advantage. An exploratory \"\n",
    "        \"AI-assisted, non-expert visual check supported the exposure proxy \"\n",
    "        \"but not the full quality composite. The archive lacks patient IDs \"\n",
    "        \"and clinical ground truth, and supplied labels are entangled with \"\n",
    "        \"layout/acquisition categories. I would value feedback on whether \"\n",
    "        \"the ranking endpoint is meaningful, how to handle shortcut risk, \"\n",
    "        \"and what evidence would be needed before pursuing any clinical \"\n",
    "        \"validation.\",\n",
    "    ),\n",
    "]\n",
    "\n",
    "brief_document = SimpleDocTemplate(\n",
    "    str(BRIEF_PATH),\n",
    "    pagesize=letter,\n",
    "    rightMargin=0.7 * inch,\n",
    "    leftMargin=0.7 * inch,\n",
    "    topMargin=0.62 * inch,\n",
    "    bottomMargin=0.65 * inch,\n",
    ")\n",
    "\n",
    "brief_document.build(\n",
    "    brief_story,\n",
    "    onFirstPage=page_footer,\n",
    "    onLaterPages=page_footer,\n",
    ")\n",
    "\n",
    "# Validate both PDFs after writing.\n",
    "report_reader = PdfReader(str(REPORT_PATH))\n",
    "brief_reader = PdfReader(str(BRIEF_PATH))\n",
    "\n",
    "assert len(report_reader.pages) >= 2\n",
    "assert len(brief_reader.pages) == 1\n",
    "\n",
    "print(\"Phase 5 report created and validated.\")\n",
    "print(\"Report pages:\", len(report_reader.pages))\n",
    "print(\"Mentor brief pages:\", len(brief_reader.pages))\n",
    "print(\"\\nReport:\", REPORT_PATH)\n",
    "print(\"Mentor brief:\", BRIEF_PATH)\n",
    "\n",
    "from IPython.display import FileLink, display\n",
    "\n",
    "display(FileLink(str(REPORT_PATH)))\n",
    "display(FileLink(str(BRIEF_PATH)))"
  ],
