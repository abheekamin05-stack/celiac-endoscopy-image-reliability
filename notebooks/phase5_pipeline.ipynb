{
  "cell_type": "code",
  "source": [
    "# Replace the preliminary folds with balanced, group-disjoint fixed folds.\n",
    "# This occurs before any training or held-out prediction review.\n",
    "\n",
    "import hashlib\n",
    "import json\n",
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "WORK = Path(\"/content/celiac_reliability_phase5\")\n",
    "canonical = pd.read_csv(WORK / \"canonical_manifest.csv\")\n",
    "\n",
    "RELATED_PAIRS = [\n",
    "    (\"Celiac/c7.JPG\",  \"Celiac/c8.JPG\"),\n",
    "    (\"Celiac/c9.JPG\",  \"Celiac/c10.JPG\"),\n",
    "    (\"Celiac/c20.JPG\", \"Celiac/c21.JPG\"),\n",
    "    (\"Celiac/c19.JPG\", \"Celiac/c6.JPG\"),\n",
    "    (\"Celiac/b3.JPG\",  \"Celiac/b7.JPG\"),\n",
    "    (\"Normal/n54.jpg\", \"Normal/n55.jpg\"),\n",
    "]\n",
    "\n",
    "SEED = 20260920\n",
    "N_FOLDS = 5\n",
    "rng = np.random.default_rng(SEED)\n",
    "\n",
    "# Build the locked related-image groups.\n",
    "file_ids = canonical[\"file_id\"].tolist()\n",
    "parent = {file_id: file_id for file_id in file_ids}\n",
    "\n",
    "def find(x):\n",
    "    while parent[x] != x:\n",
    "        parent[x] = parent[parent[x]]\n",
    "        x = parent[x]\n",
    "    return x\n",
    "\n",
    "def union(a, b):\n",
    "    root_a, root_b = find(a), find(b)\n",
    "    if root_a != root_b:\n",
    "        parent[root_b] = root_a\n",
    "\n",
    "file_lookup = {file_id.lower(): file_id for file_id in file_ids}\n",
    "\n",
    "for raw_a, raw_b in RELATED_PAIRS:\n",
    "    a = file_lookup.get(raw_a.lower())\n",
    "    b = file_lookup.get(raw_b.lower())\n",
    "    assert a is not None and b is not None, f\"Missing pair: {raw_a}, {raw_b}\"\n",
    "    union(a, b)\n",
    "\n",
    "canonical[\"group_root\"] = canonical[\"file_id\"].map(find)\n",
    "\n",
    "# Confirm every group contains images from only one supplied label.\n",
    "group_summary = (\n",
    "    canonical.groupby(\"group_root\")\n",
    "    .agg(label=(\"label\", \"first\"),\n",
    "         n_images=(\"file_id\", \"size\"),\n",
    "         label_count=(\"label\", \"nunique\"))\n",
    "    .reset_index()\n",
    ")\n",
    "assert (group_summary[\"label_count\"] == 1).all()\n",
    "\n",
    "# Assign larger related groups first. Within each label, place each group into\n",
    "# a fold with the fewest images of that label; seeded ties are deterministic.\n",
    "fold_to_groups = {fold: [] for fold in range(1, N_FOLDS + 1)}\n",
    "\n",
    "for label in [\"Celiac\", \"Normal\"]:\n",
    "    label_groups = group_summary.loc[group_summary[\"label\"] == label].copy()\n",
    "    label_groups[\"seeded_tie\"] = rng.random(len(label_groups))\n",
    "    label_groups = label_groups.sort_values(\n",
    "        [\"n_images\", \"seeded_tie\"],\n",
    "        ascending=[False, True]\n",
    "    )\n",
    "\n",
    "    label_counts = {fold: 0 for fold in fold_to_groups}\n",
    "    total_counts = {fold: 0 for fold in fold_to_groups}\n",
    "\n",
    "    for _, group in label_groups.iterrows():\n",
    "        lowest_label_count = min(label_counts.values())\n",
    "        candidates = [\n",
    "            fold for fold in fold_to_groups\n",
    "            if label_counts[fold] == lowest_label_count\n",
    "        ]\n",
    "\n",
    "        # If tied on class count, keep overall fold sizes as even as possible.\n",
    "        lowest_total_count = min(total_counts[fold] for fold in candidates)\n",
    "        candidates = [\n",
    "            fold for fold in candidates\n",
    "            if total_counts[fold] == lowest_total_count\n",
    "        ]\n",
    "\n",
    "        chosen_fold = candidates[int(rng.integers(len(candidates)))]\n",
    "        fold_to_groups[chosen_fold].append(group[\"group_root\"])\n",
    "        label_counts[chosen_fold] += int(group[\"n_images\"])\n",
    "        total_counts[chosen_fold] += int(group[\"n_images\"])\n",
    "\n",
    "canonical[\"outer_fold\"] = -1\n",
    "for fold, groups in fold_to_groups.items():\n",
    "    canonical.loc[\n",
    "        canonical[\"group_root\"].isin(groups), \"outer_fold\"\n",
    "    ] = fold\n",
    "\n",
    "assert (canonical[\"outer_fold\"] > 0).all()\n",
    "assert canonical.groupby(\"group_root\")[\"outer_fold\"].nunique().max() == 1\n",
    "\n",
    "# The required balance check.\n",
    "fold_table = (\n",
    "    canonical.groupby([\"outer_fold\", \"label\"])\n",
    "    .size()\n",
    "    .unstack(fill_value=0)\n",
    "    .assign(total=lambda x: x.sum(axis=1))\n",
    ")\n",
    "assert list(fold_table[\"Celiac\"]) == [15, 15, 15, 15, 15]\n",
    "assert sorted(fold_table[\"Normal\"].tolist()) == [16, 17, 17, 17, 17]\n",
    "\n",
    "# Save the actual fixed assignments that will be used from here onward.\n",
    "canonical[\"group_id\"] = canonical[\"group_root\"].map(\n",
    "    lambda x: f\"group_{str(x).lower().replace('/', '_').replace('.', '_')}\"\n",
    ")\n",
    "\n",
    "assignment_columns = [\n",
    "    \"file_id\", \"label\", \"group_id\", \"outer_fold\",\n",
    "    \"visible_overlay_style\", \"width\", \"height\", \"sha256\", \"working_path\"\n",
    "]\n",
    "canonical[assignment_columns].sort_values(\"file_id\").to_csv(\n",
    "    WORK / \"frozen_fold_assignments.csv\", index=False\n",
    ")\n",
    "\n",
    "metadata = {\n",
    "    \"protocol_version\": \"1.0\",\n",
    "    \"protocol_date\": \"2026-09-20\",\n",
    "    \"random_seed\": SEED,\n",
    "    \"allocation_method\": \"seeded balanced group-disjoint assignment\",\n",
    "    \"n_outer_folds\": N_FOLDS,\n",
    "    \"canonical_image_count\": int(len(canonical)),\n",
    "    \"related_pairs_grouped\": RELATED_PAIRS,\n",
    "    \"fold_class_counts\": fold_table.to_dict(orient=\"index\"),\n",
    "}\n",
    "with open(WORK / \"frozen_fold_metadata.json\", \"w\") as f:\n",
    "    json.dump(metadata, f, indent=2)\n",
    "\n",
    "print(\"Corrected fixed outer folds saved.\\n\")\n",
    "print(fold_table)\n",
    "print(f\"\\nSaved: {WORK / 'frozen_fold_assignments.csv'}\")"
  ],
  "metadata": {
    "id": "UbHMX3WSSEce"
  },
  "execution_count": null,
  "outputs": []
}
