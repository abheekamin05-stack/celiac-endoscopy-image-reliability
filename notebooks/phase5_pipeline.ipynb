{
  "cell_type": "code",
  "source": [
    "# Save the blinded visibility ratings and compare them with the automated features.\n",
    "\n",
    "from pathlib import Path\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from scipy.stats import spearmanr\n",
    "\n",
    "WORK = Path(\"/content/celiac_reliability_phase5\")\n",
    "SEED = 20260920\n",
    "rng = np.random.default_rng(SEED)\n",
    "\n",
    "ratings = [\n",
    "    (\"IMG_001\", 5, 0, 0, 0),\n",
    "    (\"IMG_002\", 2, 1, 2, 0),\n",
    "    (\"IMG_003\", 5, 0, 0, 0),\n",
    "    (\"IMG_004\", 3, 1, 1, 0),\n",
    "    (\"IMG_005\", 2, 1, 2, 0),\n",
    "    (\"IMG_006\", 5, 0, 0, 0),\n",
    "    (\"IMG_007\", 4, 0, 0, 0),\n",
    "    (\"IMG_008\", 4, 1, 1, 0),\n",
    "    (\"IMG_009\", 4, 0, 0, 0),\n",
    "    (\"IMG_010\", 3, 1, 1, 0),\n",
    "    (\"IMG_011\", 4, 0, 0, 0),\n",
    "    (\"IMG_012\", 3, 1, 2, 2),\n",
    "    (\"IMG_013\", 3, 1, 1, 0),\n",
    "    (\"IMG_014\", 4, 0, 0, 0),\n",
    "    (\"IMG_015\", 2, 2, 1, 0),\n",
    "    (\"IMG_016\", 4, 0, 0, 0),\n",
    "    (\"IMG_017\", 4, 0, 0, 0),\n",
    "    (\"IMG_018\", 3, 1, 1, 1),\n",
    "    (\"IMG_019\", 4, 0, 1, 0),\n",
    "    (\"IMG_020\", 3, 1, 1, 2),\n",
    "    (\"IMG_021\", 3, 1, 1, 0),\n",
    "    (\"IMG_022\", 4, 0, 0, 0),\n",
    "    (\"IMG_023\", 2, 1, 2, 0),\n",
    "    (\"IMG_024\", 2, 1, 2, 1),\n",
    "    (\"IMG_025\", 3, 1, 1, 2),\n",
    "    (\"IMG_026\", 4, 0, 0, 0),\n",
    "    (\"IMG_027\", 4, 0, 0, 0),\n",
    "    (\"IMG_028\", 4, 1, 0, 0),\n",
    "    (\"IMG_029\", 4, 0, 1, 0),\n",
    "    (\"IMG_030\", 4, 0, 0, 0),\n",
    "]\n",
    "\n",
    "ratings = pd.DataFrame(\n",
    "    ratings,\n",
    "    columns=[\n",
    "        \"anon_id\",\n",
    "        \"overall_visibility_1_to_5\",\n",
    "        \"blur_obstruction_0_to_2\",\n",
    "        \"exposure_obstruction_0_to_2\",\n",
    "        \"glare_obstruction_0_to_2\",\n",
    "    ],\n",
    ")\n",
    "\n",
    "# Preserve the completed sheet as an audit artifact.\n",
    "ratings.to_csv(\n",
    "    WORK / \"technical_visibility_annotation_sheet_completed.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "# Join anonymous ratings to automated features.\n",
    "# Do not select, inspect, or use any class-label or prediction columns.\n",
    "mapping = pd.read_csv(WORK / \"blinded_mapping_internal.csv\")\n",
    "features = pd.read_csv(WORK / \"frozen_reliability_features.csv\")[\n",
    "    [\n",
    "        \"file_id\",\n",
    "        \"blur_proxy\",\n",
    "        \"extreme_exposure_fraction\",\n",
    "        \"glare_fraction\",\n",
    "    ]\n",
    "]\n",
    "\n",
    "validation = (\n",
    "    ratings\n",
    "    .merge(mapping, on=\"anon_id\", validate=\"one_to_one\")\n",
    "    .merge(features, on=\"file_id\", validate=\"one_to_one\")\n",
    ")\n",
    "\n",
    "assert len(validation) == 30\n",
    "assert not any(\n",
    "    column in validation.columns\n",
    "    for column in [\"label\", \"predicted_label\", \"p_normal\", \"p_celiac\"]\n",
    ")\n",
    "\n",
    "# A higher automated value means poorer technical quality for every feature.\n",
    "quality_columns = [\n",
    "    \"blur_proxy\",\n",
    "    \"extreme_exposure_fraction\",\n",
    "    \"glare_fraction\",\n",
    "]\n",
    "\n",
    "for column in quality_columns:\n",
    "    validation[f\"{column}_within_sample_percentile\"] = validation[\n",
    "        column\n",
    "    ].rank(pct=True, method=\"average\")\n",
    "\n",
    "validation[\"automated_quality_composite\"] = validation[\n",
    "    [f\"{column}_within_sample_percentile\" for column in quality_columns]\n",
    "].mean(axis=1)\n",
    "\n",
    "comparisons = [\n",
    "    (\n",
    "        \"Blur obstruction vs. blur proxy\",\n",
    "        \"blur_obstruction_0_to_2\",\n",
    "        \"blur_proxy\",\n",
    "        \"positive\",\n",
    "    ),\n",
    "    (\n",
    "        \"Exposure obstruction vs. exposure proxy\",\n",
    "        \"exposure_obstruction_0_to_2\",\n",
    "        \"extreme_exposure_fraction\",\n",
    "        \"positive\",\n",
    "    ),\n",
    "    (\n",
    "        \"Glare obstruction vs. glare proxy\",\n",
    "        \"glare_obstruction_0_to_2\",\n",
    "        \"glare_fraction\",\n",
    "        \"positive\",\n",
    "    ),\n",
    "    (\n",
    "        \"Overall visibility vs. automated quality composite\",\n",
    "        \"overall_visibility_1_to_5\",\n",
    "        \"automated_quality_composite\",\n",
    "        \"negative\",\n",
    "    ),\n",
    "]\n",
    "\n",
    "def bootstrap_spearman(x, y, n_boot=5000):\n",
    "    x = np.asarray(x)\n",
    "    y = np.asarray(y)\n",
    "    values = []\n",
    "\n",
    "    for _ in range(n_boot):\n",
    "        indices = rng.integers(0, len(x), len(x))\n",
    "        rho = spearmanr(x[indices], y[indices]).statistic\n",
    "        if np.isfinite(rho):\n",
    "            values.append(rho)\n",
    "\n",
    "    return np.percentile(values, [2.5, 97.5])\n",
    "\n",
    "results = []\n",
    "\n",
    "for name, rating_column, feature_column, expected_direction in comparisons:\n",
    "    rho, p_value = spearmanr(\n",
    "        validation[rating_column],\n",
    "        validation[feature_column]\n",
    "    )\n",
    "    ci_low, ci_high = bootstrap_spearman(\n",
    "        validation[rating_column],\n",
    "        validation[feature_column]\n",
    "    )\n",
    "\n",
    "    results.append({\n",
    "        \"comparison\": name,\n",
    "        \"expected_direction\": expected_direction,\n",
    "        \"spearman_rho\": rho,\n",
    "        \"two_sided_p_value_exploratory\": p_value,\n",
    "        \"bootstrap_95pct_ci_low\": ci_low,\n",
    "        \"bootstrap_95pct_ci_high\": ci_high,\n",
    "    })\n",
    "\n",
    "results = pd.DataFrame(results)\n",
    "results.to_csv(\n",
    "    WORK / \"technical_visibility_feature_validation_results.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "validation.to_csv(\n",
    "    WORK / \"technical_visibility_annotation_feature_data.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "print(\"Technical-visibility validation complete.\\n\")\n",
    "print(results.to_string(index=False, float_format=lambda x: f\"{x:.3f}\"))\n",
    "print(\"\\nSaved completed ratings:\",\n",
    "      WORK / \"technical_visibility_annotation_sheet_completed.csv\")\n",
    "print(\"Saved validation results:\",\n",
    "      WORK / \"technical_visibility_feature_validation_results.csv\")"
  ],
  "metadata": {
    "id": "bDaAhimCZ6o0"
  },
  "execution_count": null,
  "outputs": []
}
{
  "cell_type": "code",
  "source": [
    "# Group-resampled bootstrap interval for the frozen 20% paired difference.\n",
    "\n",
    "import math\n",
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "WORK = Path(\"/content/celiac_reliability_phase5\")\n",
    "SEED = 20260920\n",
    "N_BOOTSTRAPS = 2000\n",
    "rng = np.random.default_rng(SEED)\n",
    "\n",
    "scores = pd.read_csv(WORK / \"frozen_review_scores_predicted_normal.csv\")\n",
    "assignments = pd.read_csv(WORK / \"frozen_fold_assignments.csv\")\n",
    "\n",
    "scores = scores.merge(\n",
    "    assignments[[\"file_id\", \"group_id\"]],\n",
    "    on=\"file_id\",\n",
    "    validate=\"one_to_one\"\n",
    ")\n",
    "\n",
    "assert len(scores) == 86\n",
    "assert scores[\"file_id\"].is_unique\n",
    "\n",
    "def recompute_rankings(frame):\n",
    "    \"\"\"Reconstruct both frozen scores within one bootstrap sample.\"\"\"\n",
    "    sample = frame.copy()\n",
    "\n",
    "    sample[\"confidence_priority_percentile\"] = (\n",
    "        1.0 - sample[\"p_normal\"].rank(\n",
    "            method=\"average\", pct=True, ascending=True\n",
    "        )\n",
    "    )\n",
    "\n",
    "    sample[\"instability_percentile\"] = sample[\n",
    "        \"instability_mean_abs_change\"\n",
    "    ].rank(method=\"average\", pct=True, ascending=True)\n",
    "\n",
    "    quality_percentile_columns = []\n",
    "    for column in [\n",
    "        \"blur_proxy\",\n",
    "        \"extreme_exposure_fraction\",\n",
    "        \"glare_fraction\",\n",
    "    ]:\n",
    "        percentile_column = f\"{column}_percentile\"\n",
    "        sample[percentile_column] = sample[column].rank(\n",
    "            method=\"average\", pct=True, ascending=True\n",
    "        )\n",
    "        quality_percentile_columns.append(percentile_column)\n",
    "\n",
    "    sample[\"technical_quality_percentile\"] = sample[\n",
    "        quality_percentile_columns\n",
    "    ].mean(axis=1)\n",
    "\n",
    "    sample[\"combined_review_priority\"] = sample[\n",
    "        [\n",
    "            \"confidence_priority_percentile\",\n",
    "            \"instability_percentile\",\n",
    "            \"technical_quality_percentile\",\n",
    "        ]\n",
    "    ].mean(axis=1)\n",
    "\n",
    "    return sample\n",
    "\n",
    "def top_k(frame, score_column, k):\n",
    "    return frame.sort_values(\n",
    "        [score_column, \"bootstrap_instance_id\"],\n",
    "        ascending=[False, True],\n",
    "        kind=\"mergesort\",\n",
    "    ).head(k)\n",
    "\n",
    "# Each related-image group is the sampling unit.\n",
    "groups = [\n",
    "    group.copy()\n",
    "    for _, group in scores.groupby(\"group_id\", sort=True)\n",
    "]\n",
    "n_groups = len(groups)\n",
    "\n",
    "bootstrap_differences = []\n",
    "bootstrap_records = []\n",
    "\n",
    "for replicate in range(N_BOOTSTRAPS):\n",
    "    drawn_group_indices = rng.integers(0, n_groups, size=n_groups)\n",
    "\n",
    "    sampled_groups = []\n",
    "    for draw_number, group_index in enumerate(drawn_group_indices):\n",
    "        drawn = groups[group_index].copy()\n",
    "        drawn[\"bootstrap_instance_id\"] = (\n",
    "            drawn[\"file_id\"] + f\"__draw_{draw_number:04d}\"\n",
    "        )\n",
    "        sampled_groups.append(drawn)\n",
    "\n",
    "    sample = pd.concat(sampled_groups, ignore_index=True)\n",
    "    sample = recompute_rankings(sample)\n",
    "\n",
    "    k = math.ceil(0.20 * len(sample))\n",
    "\n",
    "    confidence_selected = top_k(\n",
    "        sample, \"confidence_priority_percentile\", k\n",
    "    )\n",
    "    combined_selected = top_k(\n",
    "        sample, \"combined_review_priority\", k\n",
    "    )\n",
    "\n",
    "    confidence_events = int(\n",
    "        (confidence_selected[\"label\"] == \"Celiac\").sum()\n",
    "    )\n",
    "    combined_events = int(\n",
    "        (combined_selected[\"label\"] == \"Celiac\").sum()\n",
    "    )\n",
    "\n",
    "    bootstrap_differences.append(combined_events - confidence_events)\n",
    "\n",
    "    bootstrap_records.append({\n",
    "        \"replicate\": replicate + 1,\n",
    "        \"sampled_images\": len(sample),\n",
    "        \"K\": k,\n",
    "        \"confidence_events_caught\": confidence_events,\n",
    "        \"combined_events_caught\": combined_events,\n",
    "        \"paired_difference_combined_minus_confidence\": (\n",
    "            combined_events - confidence_events\n",
    "        ),\n",
    "    })\n",
    "\n",
    "bootstrap_differences = np.asarray(bootstrap_differences)\n",
    "\n",
    "observed_difference = 4 - 6  # Frozen 20% result: combined minus confidence.\n",
    "ci_low, ci_high = np.percentile(\n",
    "    bootstrap_differences, [2.5, 97.5]\n",
    ")\n",
    "\n",
    "bootstrap_table = pd.DataFrame(bootstrap_records)\n",
    "bootstrap_table.to_csv(\n",
    "    WORK / \"group_resampled_bootstrap_primary_difference.csv\",\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "summary = pd.DataFrame([{\n",
    "    \"primary_review_rate\": 0.20,\n",
    "    \"n_bootstrap_resamples\": N_BOOTSTRAPS,\n",
    "    \"sampling_unit\": \"frozen related-image group\",\n",
    "    \"observed_paired_difference_combined_minus_confidence\": observed_difference,\n",
    "    \"bootstrap_percentile_95pct_ci_low\": ci_low,\n",
    "    \"bootstrap_percentile_95pct_ci_high\": ci_high,\n",
    "    \"fraction_resamples_combined_better\": float(\n",
    "        np.mean(bootstrap_differences > 0)\n",
    "    ),\n",
    "    \"fraction_resamples_equal\": float(\n",
    "        np.mean(bootstrap_differences == 0)\n",
    "    ),\n",
    "    \"fraction_resamples_confidence_better\": float(\n",
    "        np.mean(bootstrap_differences < 0)\n",
    "    ),\n",
    "}])\n",
    "\n",
    "summary.to_csv(\n",
    "    WORK / \"group_resampled_bootstrap_primary_summary.csv\",\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "print(\"Group-resampled bootstrap complete.\")\n",
    "print(f\"Observed 20% difference, combined minus confidence: {observed_difference}\")\n",
    "print(f\"Bootstrap 95% percentile interval: [{ci_low:.1f}, {ci_high:.1f}]\")\n",
    "print(\n",
    "    \"Resample results: \"\n",
    "    f\"combined better {np.mean(bootstrap_differences > 0):.1%}, \"\n",
    "    f\"equal {np.mean(bootstrap_differences == 0):.1%}, \"\n",
    "    f\"confidence better {np.mean(bootstrap_differences < 0):.1%}\"\n",
    ")\n",
    "print(\"\\nSaved:\", WORK / \"group_resampled_bootstrap_primary_summary.csv\")"
  ],
  "metadata": {
    "id": "1oZ9yFUpaE-L"
  },
  "execution_count": null,
  "outputs": []
}
{
  "cell_type": "code",
  "source": [
    "# Central-field crop sensitivity analysis: train five crop-based ResNet-18 models\n",
    "# and save one held-out prediction for every image.\n",
    "\n",
    "import copy\n",
    "import json\n",
    "import random\n",
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from PIL import Image\n",
    "\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "from torch.utils.data import Dataset, DataLoader\n",
    "from torchvision import models, transforms\n",
    "from torchvision.models import ResNet18_Weights\n",
    "from sklearn.model_selection import StratifiedGroupKFold\n",
    "\n",
    "WORK = Path(\"/content/celiac_reliability_phase5\")\n",
    "ASSIGNMENTS = WORK / \"frozen_fold_assignments.csv\"\n",
    "MODEL_DIR = WORK / \"central_field_crop_models\"\n",
    "MODEL_DIR.mkdir(exist_ok=True)\n",
    "\n",
    "SEED = 20260920\n",
    "EPOCHS_MAX = 50\n",
    "PATIENCE = 8\n",
    "BATCH_SIZE = 16\n",
    "LEARNING_RATE = 0.0001\n",
    "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "\n",
    "random.seed(SEED)\n",
    "np.random.seed(SEED)\n",
    "torch.manual_seed(SEED)\n",
    "torch.cuda.manual_seed_all(SEED)\n",
    "torch.backends.cudnn.deterministic = True\n",
    "torch.backends.cudnn.benchmark = False\n",
    "\n",
    "assignments = pd.read_csv(ASSIGNMENTS)\n",
    "assignments[\"target\"] = (assignments[\"label\"] == \"Celiac\").astype(int)\n",
    "\n",
    "def central_field_crop(image):\n",
    "    \"\"\"Keep central 80% of width and 70% of height.\"\"\"\n",
    "    width, height = image.size\n",
    "\n",
    "    crop_width = int(round(0.80 * width))\n",
    "    crop_height = int(round(0.70 * height))\n",
    "\n",
    "    left = (width - crop_width) // 2\n",
    "    top = (height - crop_height) // 2\n",
    "\n",
    "    return image.crop((\n",
    "        left,\n",
    "        top,\n",
    "        left + crop_width,\n",
    "        top + crop_height,\n",
    "    ))\n",
    "\n",
    "preprocess = transforms.Compose([\n",
    "    transforms.Resize(\n",
    "        (224, 224),\n",
    "        interpolation=transforms.InterpolationMode.BILINEAR,\n",
    "    ),\n",
    "    transforms.ToTensor(),\n",
    "    transforms.Normalize(\n",
    "        mean=[0.485, 0.456, 0.406],\n",
    "        std=[0.229, 0.224, 0.225],\n",
    "    ),\n",
    "])\n",
    "\n",
    "class CentralFieldDataset(Dataset):\n",
    "    def __init__(self, frame):\n",
    "        self.frame = frame.reset_index(drop=True)\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.frame)\n",
    "\n",
    "    def __getitem__(self, index):\n",
    "        row = self.frame.iloc[index]\n",
    "        image = Image.open(row[\"working_path\"]).convert(\"RGB\")\n",
    "        image = central_field_crop(image)\n",
    "        image = preprocess(image)\n",
    "        target = torch.tensor(int(row[\"target\"]), dtype=torch.long)\n",
    "        return image, target\n",
    "\n",
    "def build_model():\n",
    "    model = models.resnet18(\n",
    "        weights=ResNet18_Weights.IMAGENET1K_V1\n",
    "    )\n",
    "\n",
    "    for parameter in model.parameters():\n",
    "        parameter.requires_grad = False\n",
    "\n",
    "    for parameter in model.layer4.parameters():\n",
    "        parameter.requires_grad = True\n",
    "\n",
    "    model.fc = nn.Linear(model.fc.in_features, 2)\n",
    "    for parameter in model.fc.parameters():\n",
    "        parameter.requires_grad = True\n",
    "\n",
    "    return model.to(device)\n",
    "\n",
    "all_oof_predictions = []\n",
    "training_records = []\n",
    "\n",
    "for outer_fold in range(1, 6):\n",
    "    print(f\"Training central-field crop outer fold {outer_fold}/5...\")\n",
    "\n",
    "    test_frame = assignments.loc[\n",
    "        assignments[\"outer_fold\"] == outer_fold\n",
    "    ].copy()\n",
    "\n",
    "    train_frame = assignments.loc[\n",
    "        assignments[\"outer_fold\"] != outer_fold\n",
    "    ].copy()\n",
    "\n",
    "    inner_splitter = StratifiedGroupKFold(\n",
    "        n_splits=5,\n",
    "        shuffle=True,\n",
    "        random_state=SEED + outer_fold,\n",
    "    )\n",
    "\n",
    "    inner_train_idx, validation_idx = next(\n",
    "        inner_splitter.split(\n",
    "            X=np.zeros(len(train_frame)),\n",
    "            y=train_frame[\"target\"],\n",
    "            groups=train_frame[\"group_id\"],\n",
    "        )\n",
    "    )\n",
    "\n",
    "    inner_train = train_frame.iloc[inner_train_idx].copy()\n",
    "    validation = train_frame.iloc[validation_idx].copy()\n",
    "\n",
    "    assert set(inner_train[\"group_id\"]).isdisjoint(\n",
    "        set(validation[\"group_id\"])\n",
    "    )\n",
    "    assert set(inner_train[\"group_id\"]).isdisjoint(\n",
    "        set(test_frame[\"group_id\"])\n",
    "    )\n",
    "    assert set(validation[\"group_id\"]).isdisjoint(\n",
    "        set(test_frame[\"group_id\"])\n",
    "    )\n",
    "\n",
    "    train_loader = DataLoader(\n",
    "        CentralFieldDataset(inner_train),\n",
    "        batch_size=BATCH_SIZE,\n",
    "        shuffle=True,\n",
    "        num_workers=2,\n",
    "        pin_memory=True,\n",
    "        generator=torch.Generator().manual_seed(SEED),\n",
    "    )\n",
    "\n",
    "    validation_loader = DataLoader(\n",
    "        CentralFieldDataset(validation),\n",
    "        batch_size=BATCH_SIZE,\n",
    "        shuffle=False,\n",
    "        num_workers=2,\n",
    "        pin_memory=True,\n",
    "    )\n",
    "\n",
    "    test_loader = DataLoader(\n",
    "        CentralFieldDataset(test_frame),\n",
    "        batch_size=BATCH_SIZE,\n",
    "        shuffle=False,\n",
    "        num_workers=2,\n",
    "        pin_memory=True,\n",
    "    )\n",
    "\n",
    "    model = build_model()\n",
    "\n",
    "    class_counts = inner_train[\"target\"].value_counts().to_dict()\n",
    "    class_weights = torch.tensor(\n",
    "        [\n",
    "            1.0 / class_counts.get(0, 1),\n",
    "            1.0 / class_counts.get(1, 1),\n",
    "        ],\n",
    "        dtype=torch.float32,\n",
    "        device=device,\n",
    "    )\n",
    "\n",
    "    criterion = nn.CrossEntropyLoss(weight=class_weights)\n",
    "\n",
    "    optimizer = torch.optim.Adam(\n",
    "        [\n",
    "            parameter\n",
    "            for parameter in model.parameters()\n",
    "            if parameter.requires_grad\n",
    "        ],\n",
    "        lr=LEARNING_RATE,\n",
    "    )\n",
    "\n",
    "    best_validation_loss = float(\"inf\")\n",
    "    best_state = None\n",
    "    best_epoch = 0\n",
    "    epochs_without_improvement = 0\n",
    "    fold_history = []\n",
    "\n",
    "    for epoch in range(1, EPOCHS_MAX + 1):\n",
    "        model.train()\n",
    "        train_loss_total = 0.0\n",
    "        train_examples = 0\n",
    "\n",
    "        for images, targets in train_loader:\n",
    "            images = images.to(device, non_blocking=True)\n",
    "            targets = targets.to(device, non_blocking=True)\n",
    "\n",
    "            optimizer.zero_grad(set_to_none=True)\n",
    "            logits = model(images)\n",
    "            loss = criterion(logits, targets)\n",
    "            loss.backward()\n",
    "            optimizer.step()\n",
    "\n",
    "            train_loss_total += loss.item() * len(targets)\n",
    "            train_examples += len(targets)\n",
    "\n",
    "        model.eval()\n",
    "        validation_loss_total = 0.0\n",
    "        validation_examples = 0\n",
    "\n",
    "        with torch.no_grad():\n",
    "            for images, targets in validation_loader:\n",
    "                images = images.to(device, non_blocking=True)\n",
    "                targets = targets.to(device, non_blocking=True)\n",
    "\n",
    "                logits = model(images)\n",
    "                loss = criterion(logits, targets)\n",
    "\n",
    "                validation_loss_total += loss.item() * len(targets)\n",
    "                validation_examples += len(targets)\n",
    "\n",
    "        train_loss = train_loss_total / train_examples\n",
    "        validation_loss = validation_loss_total / validation_examples\n",
    "\n",
    "        fold_history.append({\n",
    "            \"epoch\": epoch,\n",
    "            \"train_loss\": train_loss,\n",
    "            \"validation_loss\": validation_loss,\n",
    "        })\n",
    "\n",
    "        if validation_loss < best_validation_loss:\n",
    "            best_validation_loss = validation_loss\n",
    "            best_state = copy.deepcopy(model.state_dict())\n",
    "            best_epoch = epoch\n",
    "            epochs_without_improvement = 0\n",
    "        else:\n",
    "            epochs_without_improvement += 1\n",
    "\n",
    "        if epochs_without_improvement >= PATIENCE:\n",
    "            break\n",
    "\n",
    "    assert best_state is not None\n",
    "    model.load_state_dict(best_state)\n",
    "    model.eval()\n",
    "\n",
    "    probabilities_by_batch = []\n",
    "\n",
    "    with torch.no_grad():\n",
    "        for images, _ in test_loader:\n",
    "            images = images.to(device, non_blocking=True)\n",
    "            logits = model(images)\n",
    "            probabilities_by_batch.append(\n",
    "                torch.softmax(logits, dim=1).cpu().numpy()\n",
    "            )\n",
    "\n",
    "    probabilities = np.concatenate(probabilities_by_batch, axis=0)\n",
    "\n",
    "    fold_predictions = test_frame[\n",
    "        [\"file_id\", \"label\", \"outer_fold\", \"group_id\"]\n",
    "    ].reset_index(drop=True).copy()\n",
    "\n",
    "    fold_predictions[\"p_normal\"] = probabilities[:, 0]\n",
    "    fold_predictions[\"p_celiac\"] = probabilities[:, 1]\n",
    "    fold_predictions[\"predicted_label\"] = np.where(\n",
    "        fold_predictions[\"p_normal\"] >= 0.50,\n",
    "        \"Normal\",\n",
    "        \"Celiac\",\n",
    "    )\n",
    "\n",
    "    all_oof_predictions.append(fold_predictions)\n",
    "\n",
    "    torch.save(\n",
    "        {\n",
    "            \"model_state_dict\": best_state,\n",
    "            \"outer_fold\": outer_fold,\n",
    "            \"best_epoch\": best_epoch,\n",
    "            \"best_validation_loss\": best_validation_loss,\n",
    "            \"seed\": SEED,\n",
    "            \"protocol\": (\n",
    "                \"central 80% width x 70% height crop; \"\n",
    "                \"ResNet-18 layer4 + head fine-tuning\"\n",
    "            ),\n",
    "        },\n",
    "        MODEL_DIR / f\"central_crop_resnet18_outer_fold_{outer_fold}.pt\",\n",
    "    )\n",
    "\n",
    "    with open(\n",
    "        MODEL_DIR / f\"training_history_fold_{outer_fold}.json\",\n",
    "        \"w\",\n",
    "    ) as file:\n",
    "        json.dump(fold_history, file, indent=2)\n",
    "\n",
    "    training_records.append({\n",
    "        \"outer_fold\": outer_fold,\n",
    "        \"train_images\": len(inner_train),\n",
    "        \"validation_images\": len(validation),\n",
    "        \"heldout_images\": len(test_frame),\n",
    "        \"best_epoch\": best_epoch,\n",
    "        \"best_validation_loss\": best_validation_loss,\n",
    "    })\n",
    "\n",
    "    del model, optimizer\n",
    "    torch.cuda.empty_cache()\n",
    "\n",
    "oof_predictions = (\n",
    "    pd.concat(all_oof_predictions, ignore_index=True)\n",
    "    .sort_values(\"file_id\")\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "assert len(oof_predictions) == 159\n",
    "assert oof_predictions[\"file_id\"].is_unique\n",
    "assert oof_predictions[\"p_normal\"].between(0, 1).all()\n",
    "\n",
    "oof_predictions.to_csv(\n",
    "    WORK / \"central_field_crop_oof_predictions.csv\",\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "with open(\n",
    "    WORK / \"central_field_crop_training_records.json\",\n",
    "    \"w\",\n",
    ") as file:\n",
    "    json.dump(training_records, file, indent=2)\n",
    "\n",
    "print(\"\\nCentral-field crop training complete.\")\n",
    "print(\"Saved:\", WORK / \"central_field_crop_oof_predictions.csv\")\n",
    "print(\"Models:\", MODEL_DIR)"
  ],
