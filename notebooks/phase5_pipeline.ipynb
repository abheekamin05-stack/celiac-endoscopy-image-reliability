{
  "cell_type": "code",
  "source": [
    "# Generate prediction-instability and technical-image-quality features.\n",
    "\n",
    "import io\n",
    "from pathlib import Path\n",
    "\n",
    "import cv2\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "from PIL import Image, ImageEnhance\n",
    "from torchvision import models, transforms\n",
    "from torchvision.models import ResNet18_Weights\n",
    "\n",
    "WORK = Path(\"/content/celiac_reliability_phase5\")\n",
    "MODEL_DIR = WORK / \"models\"\n",
    "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "\n",
    "SEED = 20260920\n",
    "\n",
    "assignments = pd.read_csv(WORK / \"frozen_fold_assignments.csv\")\n",
    "oof = pd.read_csv(WORK / \"frozen_oof_predictions.csv\")\n",
    "\n",
    "assert len(assignments) == 159\n",
    "assert len(oof) == 159\n",
    "assert set(assignments[\"file_id\"]) == set(oof[\"file_id\"])\n",
    "\n",
    "preprocess = transforms.Compose([\n",
    "    transforms.Resize((224, 224), interpolation=transforms.InterpolationMode.BILINEAR),\n",
    "    transforms.ToTensor(),\n",
    "    transforms.Normalize(\n",
    "        mean=[0.485, 0.456, 0.406],\n",
    "        std=[0.229, 0.224, 0.225]\n",
    "    )\n",
    "])\n",
    "\n",
    "def build_model():\n",
    "    model = models.resnet18(weights=None)\n",
    "\n",
    "    for parameter in model.parameters():\n",
    "        parameter.requires_grad = False\n",
    "\n",
    "    for parameter in model.layer4.parameters():\n",
    "        parameter.requires_grad = True\n",
    "\n",
    "    model.fc = nn.Linear(model.fc.in_features, 2)\n",
    "    return model.to(device)\n",
    "\n",
    "def load_fold_model(fold):\n",
    "    checkpoint = torch.load(\n",
    "        MODEL_DIR / f\"resnet18_outer_fold_{fold}.pt\",\n",
    "        map_location=device\n",
    "    )\n",
    "    model = build_model()\n",
    "    model.load_state_dict(checkpoint[\"model_state_dict\"])\n",
    "    model.eval()\n",
    "    return model\n",
    "\n",
    "def predict_p_normal(model, image):\n",
    "    tensor = preprocess(image).unsqueeze(0).to(device)\n",
    "    with torch.no_grad():\n",
    "        probabilities = torch.softmax(model(tensor), dim=1)\n",
    "    return float(probabilities[0, 0].cpu().item())\n",
    "\n",
    "def jpeg_recompress(image, quality):\n",
    "    buffer = io.BytesIO()\n",
    "    image.save(buffer, format=\"JPEG\", quality=quality)\n",
    "    buffer.seek(0)\n",
    "    return Image.open(buffer).convert(\"RGB\")\n",
    "\n",
    "def technical_quality_features(image):\n",
    "    rgb = np.asarray(image.convert(\"RGB\"))\n",
    "    height, width = rgb.shape[:2]\n",
    "\n",
    "    # Central 60% width × 60% height, as specified in the protocol.\n",
    "    x0 = int(round(0.20 * width))\n",
    "    x1 = int(round(0.80 * width))\n",
    "    y0 = int(round(0.20 * height))\n",
    "    y1 = int(round(0.80 * height))\n",
    "\n",
    "    central = rgb[y0:y1, x0:x1]\n",
    "    gray = cv2.cvtColor(central, cv2.COLOR_RGB2GRAY)\n",
    "\n",
    "    laplacian_variance = float(cv2.Laplacian(gray, cv2.CV_64F).var())\n",
    "    blur_proxy = 1.0 / (1.0 + laplacian_variance)\n",
    "\n",
    "    extreme_exposure_fraction = float(\n",
    "        np.mean((gray < 20) | (gray > 235))\n",
    "    )\n",
    "\n",
    "    glare_fraction = float(\n",
    "        np.mean(np.all(central > 245, axis=2))\n",
    "    )\n",
    "\n",
    "    return {\n",
    "        \"blur_proxy\": blur_proxy,\n",
    "        \"extreme_exposure_fraction\": extreme_exposure_fraction,\n",
    "        \"glare_fraction\": glare_fraction\n",
    "    }\n",
    "\n",
    "# Load each fold model once.\n",
    "fold_models = {\n",
    "    fold: load_fold_model(fold)\n",
    "    for fold in range(1, 6)\n",
    "}\n",
    "\n",
    "feature_rows = []\n",
    "\n",
    "for _, row in assignments.sort_values(\"file_id\").iterrows():\n",
    "    image = Image.open(row[\"working_path\"]).convert(\"RGB\")\n",
    "    model = fold_models[int(row[\"outer_fold\"])]\n",
    "\n",
    "    original_p_normal = predict_p_normal(model, image)\n",
    "\n",
    "    transformed_images = {\n",
    "        \"brightness_090\": ImageEnhance.Brightness(image).enhance(0.90),\n",
    "        \"brightness_110\": ImageEnhance.Brightness(image).enhance(1.10),\n",
    "        \"jpeg_quality_75\": jpeg_recompress(image, 75),\n",
    "        \"jpeg_quality_90\": jpeg_recompress(image, 90),\n",
    "    }\n",
    "\n",
    "    transformed_p_normal = {\n",
    "        name: predict_p_normal(model, transformed)\n",
    "        for name, transformed in transformed_images.items()\n",
    "    }\n",
    "\n",
    "    shifts = [\n",
    "        abs(value - original_p_normal)\n",
    "        for value in transformed_p_normal.values()\n",
    "    ]\n",
    "\n",
    "    quality = technical_quality_features(image)\n",
    "\n",
    "    feature_rows.append({\n",
    "        \"file_id\": row[\"file_id\"],\n",
    "        \"outer_fold\": int(row[\"outer_fold\"]),\n",
    "        \"p_normal_original_recomputed\": original_p_normal,\n",
    "        \"p_normal_brightness_090\": transformed_p_normal[\"brightness_090\"],\n",
    "        \"p_normal_brightness_110\": transformed_p_normal[\"brightness_110\"],\n",
    "        \"p_normal_jpeg_quality_75\": transformed_p_normal[\"jpeg_quality_75\"],\n",
    "        \"p_normal_jpeg_quality_90\": transformed_p_normal[\"jpeg_quality_90\"],\n",
    "        \"instability_mean_abs_change\": float(np.mean(shifts)),\n",
    "        **quality\n",
    "    })\n",
    "\n",
    "features = pd.DataFrame(feature_rows)\n",
    "\n",
    "# Join only for bookkeeping. No labels are used in feature calculation.\n",
    "features = (\n",
    "    oof[[\"file_id\", \"label\", \"predicted_label\", \"p_normal\", \"p_celiac\"]]\n",
    "    .merge(features, on=\"file_id\", validate=\"one_to_one\")\n",
    "    .sort_values(\"file_id\")\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "assert len(features) == 159\n",
    "assert features[\"file_id\"].is_unique\n",
    "assert features[\"instability_mean_abs_change\"].ge(0).all()\n",
    "assert features[\"blur_proxy\"].ge(0).all()\n",
    "assert features[\"extreme_exposure_fraction\"].between(0, 1).all()\n",
    "assert features[\"glare_fraction\"].between(0, 1).all()\n",
    "\n",
    "features.to_csv(WORK / \"frozen_reliability_features.csv\", index=False)\n",
    "\n",
    "print(\"Feature generation complete.\")\n",
    "print(f\"Rows saved: {len(features)}\")\n",
    "print(f\"Output: {WORK / 'frozen_reliability_features.csv'}\")\n",
    "print(\"Features saved: instability, blur, exposure, and glare.\")"
  ],
  "metadata": {
    "id": "cUffx0SCVA52"
  },
  "execution_count": null,
  "outputs": []
}
{
  "cell_type": "code",
  "source": [
    "# Create the frozen confidence-only and combined review-priority scores.\n",
    "\n",
    "import math\n",
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "WORK = Path(\"/content/celiac_reliability_phase5\")\n",
    "\n",
    "features = pd.read_csv(WORK / \"frozen_reliability_features.csv\")\n",
    "\n",
    "assert len(features) == 159\n",
    "assert features[\"file_id\"].is_unique\n",
    "\n",
    "# The score is defined only for images whose frozen classifier prediction is Normal.\n",
    "predicted_normal = features.loc[\n",
    "    features[\"predicted_label\"] == \"Normal\"\n",
    "].copy()\n",
    "\n",
    "assert len(predicted_normal) > 0\n",
    "\n",
    "# Feature A: weak Normal confidence.\n",
    "# Lower p_normal means greater review priority.\n",
    "predicted_normal[\"confidence_priority_percentile\"] = (\n",
    "    1.0 - predicted_normal[\"p_normal\"].rank(\n",
    "        method=\"average\",\n",
    "        pct=True,\n",
    "        ascending=True\n",
    "    )\n",
    ")\n",
    "\n",
    "# Feature B: prediction instability.\n",
    "# Larger mean absolute probability change means greater priority.\n",
    "predicted_normal[\"instability_percentile\"] = (\n",
    "    predicted_normal[\"instability_mean_abs_change\"].rank(\n",
    "        method=\"average\",\n",
    "        pct=True,\n",
    "        ascending=True\n",
    "    )\n",
    ")\n",
    "\n",
    "# Feature C: technical quality.\n",
    "# Each measure is a poor-quality proxy where larger means worse.\n",
    "for column in [\n",
    "    \"blur_proxy\",\n",
    "    \"extreme_exposure_fraction\",\n",
    "    \"glare_fraction\"\n",
    "]:\n",
    "    predicted_normal[f\"{column}_percentile\"] = (\n",
    "        predicted_normal[column].rank(\n",
    "            method=\"average\",\n",
    "            pct=True,\n",
    "            ascending=True\n",
    "        )\n",
    "    )\n",
    "\n",
    "predicted_normal[\"technical_quality_percentile\"] = predicted_normal[\n",
    "    [\n",
    "        \"blur_proxy_percentile\",\n",
    "        \"extreme_exposure_fraction_percentile\",\n",
    "        \"glare_fraction_percentile\"\n",
    "    ]\n",
    "].mean(axis=1)\n",
    "\n",
    "# Equal-weight combined score, exactly as specified.\n",
    "predicted_normal[\"combined_review_priority\"] = predicted_normal[\n",
    "    [\n",
    "        \"confidence_priority_percentile\",\n",
    "        \"instability_percentile\",\n",
    "        \"technical_quality_percentile\"\n",
    "    ]\n",
    "].mean(axis=1)\n",
    "\n",
    "# Add deterministic ranking orders. Exact ties are resolved by filename ascending.\n",
    "confidence_order = predicted_normal.sort_values(\n",
    "    [\"confidence_priority_percentile\", \"file_id\"],\n",
    "    ascending=[False, True],\n",
    "    kind=\"mergesort\"\n",
    ").index\n",
    "\n",
    "combined_order = predicted_normal.sort_values(\n",
    "    [\"combined_review_priority\", \"file_id\"],\n",
    "    ascending=[False, True],\n",
    "    kind=\"mergesort\"\n",
    ").index\n",
    "\n",
    "predicted_normal[\"confidence_priority_rank\"] = np.nan\n",
    "predicted_normal.loc[confidence_order, \"confidence_priority_rank\"] = (\n",
    "    np.arange(1, len(predicted_normal) + 1)\n",
    ")\n",
    "\n",
    "predicted_normal[\"combined_review_priority_rank\"] = np.nan\n",
    "predicted_normal.loc[combined_order, \"combined_review_priority_rank\"] = (\n",
    "    np.arange(1, len(predicted_normal) + 1)\n",
    ")\n",
    "\n",
    "# The primary review rate is 20%, rounded upward.\n",
    "N = len(predicted_normal)\n",
    "K_20 = math.ceil(0.20 * N)\n",
    "\n",
    "predicted_normal[\"primary_review_rate\"] = 0.20\n",
    "predicted_normal[\"primary_review_count_K\"] = K_20\n",
    "\n",
    "# Save only the score table. Held-out labels remain present for later evaluation,\n",
    "# but are not used in any score calculation.\n",
    "predicted_normal = predicted_normal.sort_values(\"file_id\").reset_index(drop=True)\n",
    "\n",
    "predicted_normal.to_csv(\n",
    "    WORK / \"frozen_review_scores_predicted_normal.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "# Save the score-construction metadata.\n",
    "score_metadata = {\n",
    "    \"scoring_population_definition\": \"pooled held-out images predicted Normal\",\n",
    "    \"n_predicted_normal\": int(N),\n",
    "    \"primary_review_rate\": 0.20,\n",
    "    \"primary_review_count_K\": int(K_20),\n",
    "    \"confidence_weight\": 1 / 3,\n",
    "    \"instability_weight\": 1 / 3,\n",
    "    \"technical_quality_weight\": 1 / 3,\n",
    "    \"technical_quality_components\": [\n",
    "        \"blur_proxy\",\n",
    "        \"extreme_exposure_fraction\",\n",
    "        \"glare_fraction\"\n",
    "    ],\n",
    "    \"tie_rule\": \"filename ascending\",\n",
    "    \"labels_used_to_construct_scores\": False\n",
    "}\n",
    "\n",
    "import json\n",
    "with open(WORK / \"frozen_score_metadata.json\", \"w\") as f:\n",
    "    json.dump(score_metadata, f, indent=2)\n",
    "\n",
    "print(\"Frozen review scores created.\")\n",
    "print(f\"Predicted-Normal images: {N}\")\n",
    "print(f\"Primary review count K: {K_20}\")\n",
    "print(f\"Saved: {WORK / 'frozen_review_scores_predicted_normal.csv'}\")"
  ],
  "metadata": {
    "id": "yHJDx1EAWk9W"
  },
  "execution_count": null,
  "outputs": []
}
{
  "cell_type": "code",
  "source": [
    "# Evaluate the frozen review rankings at 10%, 20%, and 30%.\n",
    "\n",
    "import json\n",
    "import math\n",
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "WORK = Path(\"/content/celiac_reliability_phase5\")\n",
    "scores = pd.read_csv(WORK / \"frozen_review_scores_predicted_normal.csv\")\n",
    "all_features = pd.read_csv(WORK / \"frozen_reliability_features.csv\")\n",
    "\n",
    "assert scores[\"file_id\"].is_unique\n",
    "assert len(scores) == 86\n",
    "\n",
    "def select_top_k(frame, score_column, k):\n",
    "    return frame.sort_values(\n",
    "        [score_column, \"file_id\"],\n",
    "        ascending=[False, True],\n",
    "        kind=\"mergesort\"\n",
    "    ).head(k).copy()\n",
    "\n",
    "def summarize_selection(selected, population_size, total_target_events):\n",
    "    target_events_caught = int((selected[\"label\"] == \"Celiac\").sum())\n",
    "    normal_alerts = int((selected[\"label\"] == \"Normal\").sum())\n",
    "\n",
    "    return {\n",
    "        \"flagged\": int(len(selected)),\n",
    "        \"target_events_caught\": target_events_caught,\n",
    "        \"normal_alerts\": normal_alerts,\n",
    "        \"flagged_event_fraction\": (\n",
    "            target_events_caught / len(selected) if len(selected) else None\n",
    "        ),\n",
    "        \"capture_among_all_predicted_normal_events\": (\n",
    "            target_events_caught / total_target_events\n",
    "            if total_target_events else None\n",
    "        ),\n",
    "        \"actual_review_percentage\": len(selected) / population_size\n",
    "    }\n",
    "\n",
    "N = len(scores)\n",
    "F = int((scores[\"label\"] == \"Celiac\").sum())\n",
    "\n",
    "results = {\n",
    "    \"n_predicted_normal\": N,\n",
    "    \"celiac_labeled_among_predicted_normal\": F,\n",
    "    \"comparisons\": {}\n",
    "}\n",
    "\n",
    "for rate in [0.10, 0.20, 0.30]:\n",
    "    k = math.ceil(rate * N)\n",
    "\n",
    "    confidence_selected = select_top_k(\n",
    "        scores,\n",
    "        \"confidence_priority_percentile\",\n",
    "        k\n",
    "    )\n",
    "\n",
    "    combined_selected = select_top_k(\n",
    "        scores,\n",
    "        \"combined_review_priority\",\n",
    "        k\n",
    "    )\n",
    "\n",
    "    confidence_summary = summarize_selection(\n",
    "        confidence_selected, N, F\n",
    "    )\n",
    "    combined_summary = summarize_selection(\n",
    "        combined_selected, N, F\n",
    "    )\n",
    "\n",
    "    comparison = {\n",
    "        \"requested_rate\": rate,\n",
    "        \"K\": k,\n",
    "        \"confidence_only\": confidence_summary,\n",
    "        \"combined\": combined_summary,\n",
    "        \"paired_difference_combined_minus_confidence\": (\n",
    "            combined_summary[\"target_events_caught\"]\n",
    "            - confidence_summary[\"target_events_caught\"]\n",
    "        ),\n",
    "        \"overlap_between_flagged_sets\": int(\n",
    "            len(\n",
    "                set(confidence_selected[\"file_id\"])\n",
    "                & set(combined_selected[\"file_id\"])\n",
    "            )\n",
    "        )\n",
    "    }\n",
    "\n",
    "    results[\"comparisons\"][str(rate)] = comparison\n",
    "\n",
    "# Secondary equal-rank ablations at the primary 20% review rate.\n",
    "K_20 = math.ceil(0.20 * N)\n",
    "\n",
    "scores[\"confidence_plus_instability\"] = scores[\n",
    "    [\n",
    "        \"confidence_priority_percentile\",\n",
    "        \"instability_percentile\"\n",
    "    ]\n",
    "].mean(axis=1)\n",
    "\n",
    "scores[\"confidence_plus_quality\"] = scores[\n",
    "    [\n",
    "        \"confidence_priority_percentile\",\n",
    "        \"technical_quality_percentile\"\n",
    "    ]\n",
    "].mean(axis=1)\n",
    "\n",
    "ablations = {}\n",
    "for name, column in [\n",
    "    (\"confidence_plus_instability\", \"confidence_plus_instability\"),\n",
    "    (\"confidence_plus_quality\", \"confidence_plus_quality\")\n",
    "]:\n",
    "    selected = select_top_k(scores, column, K_20)\n",
    "    ablations[name] = summarize_selection(selected, N, F)\n",
    "\n",
    "results[\"primary_20_percent_ablations\"] = ablations\n",
    "\n",
    "# Overall classifier confusion counts against the supplied image labels.\n",
    "all_features[\"true_label\"] = all_features[\"label\"]\n",
    "all_features[\"predicted_label_frozen\"] = all_features[\"predicted_label\"]\n",
    "\n",
    "confusion = pd.crosstab(\n",
    "    all_features[\"true_label\"],\n",
    "    all_features[\"predicted_label_frozen\"]\n",
    ").reindex(\n",
    "    index=[\"Normal\", \"Celiac\"],\n",
    "    columns=[\"Normal\", \"Celiac\"],\n",
    "    fill_value=0\n",
    ")\n",
    "\n",
    "results[\"classifier_confusion_counts\"] = {\n",
    "    true_label: {\n",
    "        predicted_label: int(confusion.loc[true_label, predicted_label])\n",
    "        for predicted_label in confusion.columns\n",
    "    }\n",
    "    for true_label in confusion.index\n",
    "}\n",
    "\n",
    "# Save selected filenames for later overlap and bootstrap analyses.\n",
    "for rate in [0.10, 0.20, 0.30]:\n",
    "    k = math.ceil(rate * N)\n",
    "\n",
    "    select_top_k(\n",
    "        scores,\n",
    "        \"confidence_priority_percentile\",\n",
    "        k\n",
    "    ).to_csv(WORK / f\"confidence_selected_{int(rate*100)}pct.csv\", index=False)\n",
    "\n",
    "    select_top_k(\n",
    "        scores,\n",
    "        \"combined_review_priority\",\n",
    "        k\n",
    "    ).to_csv(WORK / f\"combined_selected_{int(rate*100)}pct.csv\", index=False)\n",
    "\n",
    "with open(WORK / \"frozen_primary_comparison_results.json\", \"w\") as f:\n",
    "    json.dump(results, f, indent=2)\n",
    "\n",
    "print(\"Frozen ranking comparison complete.\\n\")\n",
    "print(f\"Predicted-Normal images: {N}\")\n",
    "print(f\"Celiac-labeled images among them: {F}\\n\")\n",
    "\n",
    "for rate in [0.10, 0.20, 0.30]:\n",
    "    comparison = results[\"comparisons\"][str(rate)]\n",
    "    print(f\"{int(rate*100)}% requested review rate, K={comparison['K']}\")\n",
    "    print(\n",
    "        \"  Confidence-only:\",\n",
    "        comparison[\"confidence_only\"][\"target_events_caught\"],\n",
    "        \"target events caught\"\n",
    "    )\n",
    "    print(\n",
    "        \"  Combined:\",\n",
    "        comparison[\"combined\"][\"target_events_caught\"],\n",
    "        \"target events caught\"\n",
    "    )\n",
    "    print(\n",
    "        \"  Difference:\",\n",
    "        comparison[\"paired_difference_combined_minus_confidence\"]\n",
    "    )\n",
    "    print()\n",
    "\n",
    "print(\"Classifier confusion counts:\")\n",
    "print(confusion)\n",
    "print(f\"\\nSaved: {WORK / 'frozen_primary_comparison_results.json'}\")"
  ],
  "metadata": {
    "id": "yjQMJoomW7Up"
  },
  "execution_count": null,
  "outputs": []
}
{
  "cell_type": "code",
  "source": [
    "# Create a blinded 30-image technical-visibility annotation set.\n",
    "\n",
    "import shutil\n",
    "from pathlib import Path\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "import pandas as pd\n",
