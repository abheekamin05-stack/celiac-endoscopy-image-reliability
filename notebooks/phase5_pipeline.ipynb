{
  "cell_type": "code",
  "source": [
    "# Train the frozen five-fold ResNet-18 classifier and save out-of-fold predictions.\n",
    "\n",
    "import copy\n",
    "import json\n",
    "import random\n",
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from PIL import Image\n",
    "\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "from torch.utils.data import Dataset, DataLoader\n",
    "from torchvision import models, transforms\n",
    "from torchvision.models import ResNet18_Weights\n",
    "from sklearn.model_selection import StratifiedGroupKFold\n",
    "\n",
    "WORK = Path(\"/content/celiac_reliability_phase5\")\n",
    "ASSIGNMENTS = WORK / \"frozen_fold_assignments.csv\"\n",
    "MODEL_DIR = WORK / \"models\"\n",
    "MODEL_DIR.mkdir(exist_ok=True)\n",
    "\n",
    "SEED = 20260920\n",
    "EPOCHS_MAX = 50\n",
    "PATIENCE = 8\n",
    "BATCH_SIZE = 16\n",
    "LEARNING_RATE = 0.0001\n",
    "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "\n",
    "# Reproducibility settings.\n",
    "random.seed(SEED)\n",
    "np.random.seed(SEED)\n",
    "torch.manual_seed(SEED)\n",
    "torch.cuda.manual_seed_all(SEED)\n",
    "torch.backends.cudnn.deterministic = True\n",
    "torch.backends.cudnn.benchmark = False\n",
    "\n",
    "assignments = pd.read_csv(ASSIGNMENTS)\n",
    "assignments[\"target\"] = (assignments[\"label\"] == \"Celiac\").astype(int)\n",
    "\n",
    "assert len(assignments) == 159\n",
    "assert assignments[\"outer_fold\"].between(1, 5).all()\n",
    "\n",
    "# The protocol specifies resize only, with ImageNet normalization.\n",
    "preprocess = transforms.Compose([\n",
    "    transforms.Resize((224, 224), interpolation=transforms.InterpolationMode.BILINEAR),\n",
    "    transforms.ToTensor(),\n",
    "    transforms.Normalize(\n",
    "        mean=[0.485, 0.456, 0.406],\n",
    "        std=[0.229, 0.224, 0.225]\n",
    "    )\n",
    "])\n",
    "\n",
    "class CeliacDataset(Dataset):\n",
    "    def __init__(self, frame):\n",
    "        self.frame = frame.reset_index(drop=True)\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.frame)\n",
    "\n",
    "    def __getitem__(self, index):\n",
    "        row = self.frame.iloc[index]\n",
    "        image = Image.open(row[\"working_path\"]).convert(\"RGB\")\n",
    "        image = preprocess(image)\n",
    "        target = torch.tensor(int(row[\"target\"]), dtype=torch.long)\n",
    "        return image, target\n",
    "\n",
    "def build_model():\n",
    "    weights = ResNet18_Weights.IMAGENET1K_V1\n",
    "    model = models.resnet18(weights=weights)\n",
    "\n",
    "    # Freeze all earlier layers.\n",
    "    for parameter in model.parameters():\n",
    "        parameter.requires_grad = False\n",
    "\n",
    "    # Fine-tune only the final residual block and classification head.\n",
    "    for parameter in model.layer4.parameters():\n",
    "        parameter.requires_grad = True\n",
    "\n",
    "    model.fc = nn.Linear(model.fc.in_features, 2)\n",
    "    for parameter in model.fc.parameters():\n",
    "        parameter.requires_grad = True\n",
    "\n",
    "    return model.to(device)\n",
    "\n",
    "all_oof_predictions = []\n",
    "training_records = []\n",
    "\n",
    "for outer_fold in range(1, 6):\n",
    "    print(f\"Training outer fold {outer_fold}/5...\")\n",
    "\n",
    "    test_frame = assignments.loc[\n",
    "        assignments[\"outer_fold\"] == outer_fold\n",
    "    ].copy()\n",
    "\n",
    "    train_frame = assignments.loc[\n",
    "        assignments[\"outer_fold\"] != outer_fold\n",
    "    ].copy()\n",
    "\n",
    "    # Reserve approximately 20% of the training data for early stopping.\n",
    "    # This split is group-disjoint and does not use the outer held-out fold.\n",
    "    inner_splitter = StratifiedGroupKFold(\n",
    "        n_splits=5,\n",
    "        shuffle=True,\n",
    "        random_state=SEED + outer_fold\n",
    "    )\n",
    "\n",
    "    inner_train_idx, validation_idx = next(\n",
    "        inner_splitter.split(\n",
    "            X=np.zeros(len(train_frame)),\n",
    "            y=train_frame[\"target\"],\n",
    "            groups=train_frame[\"group_id\"]\n",
    "        )\n",
    "    )\n",
    "\n",
    "    inner_train = train_frame.iloc[inner_train_idx].copy()\n",
    "    validation = train_frame.iloc[validation_idx].copy()\n",
    "\n",
    "    assert set(inner_train[\"group_id\"]).isdisjoint(set(validation[\"group_id\"]))\n",
    "    assert set(inner_train[\"group_id\"]).isdisjoint(set(test_frame[\"group_id\"]))\n",
    "    assert set(validation[\"group_id\"]).isdisjoint(set(test_frame[\"group_id\"]))\n",
    "\n",
    "    train_loader = DataLoader(\n",
    "        CeliacDataset(inner_train),\n",
    "        batch_size=BATCH_SIZE,\n",
    "        shuffle=True,\n",
    "        num_workers=2,\n",
    "        pin_memory=True,\n",
    "        generator=torch.Generator().manual_seed(SEED)\n",
    "    )\n",
    "\n",
    "    validation_loader = DataLoader(\n",
    "        CeliacDataset(validation),\n",
    "        batch_size=BATCH_SIZE,\n",
    "        shuffle=False,\n",
    "        num_workers=2,\n",
    "        pin_memory=True\n",
    "    )\n",
    "\n",
    "    test_loader = DataLoader(\n",
    "        CeliacDataset(test_frame),\n",
    "        batch_size=BATCH_SIZE,\n",
    "        shuffle=False,\n",
    "        num_workers=2,\n",
    "        pin_memory=True\n",
    "    )\n",
    "\n",
    "    model = build_model()\n",
    "\n",
    "    class_counts = inner_train[\"target\"].value_counts().to_dict()\n",
    "    class_weights = torch.tensor(\n",
    "        [\n",
    "            1.0 / class_counts.get(0, 1),\n",
    "            1.0 / class_counts.get(1, 1)\n",
    "        ],\n",
    "        dtype=torch.float32,\n",
    "        device=device\n",
    "    )\n",
    "\n",
    "    criterion = nn.CrossEntropyLoss(weight=class_weights)\n",
    "\n",
    "    trainable_parameters = [\n",
    "        parameter for parameter in model.parameters()\n",
    "        if parameter.requires_grad\n",
    "    ]\n",
    "    optimizer = torch.optim.Adam(\n",
    "        trainable_parameters,\n",
    "        lr=LEARNING_RATE\n",
    "    )\n",
    "\n",
    "    best_validation_loss = float(\"inf\")\n",
    "    best_state = None\n",
    "    best_epoch = 0\n",
    "    epochs_without_improvement = 0\n",
    "    fold_history = []\n",
    "\n",
    "    for epoch in range(1, EPOCHS_MAX + 1):\n",
    "        model.train()\n",
    "        train_loss_total = 0.0\n",
    "        train_examples = 0\n",
    "\n",
    "        for images, targets in train_loader:\n",
    "            images = images.to(device, non_blocking=True)\n",
    "            targets = targets.to(device, non_blocking=True)\n",
    "\n",
    "            optimizer.zero_grad(set_to_none=True)\n",
    "            logits = model(images)\n",
    "            loss = criterion(logits, targets)\n",
    "            loss.backward()\n",
    "            optimizer.step()\n",
    "\n",
    "            train_loss_total += loss.item() * len(targets)\n",
    "            train_examples += len(targets)\n",
    "\n",
    "        model.eval()\n",
    "        validation_loss_total = 0.0\n",
    "        validation_examples = 0\n",
    "\n",
    "        with torch.no_grad():\n",
    "            for images, targets in validation_loader:\n",
    "                images = images.to(device, non_blocking=True)\n",
    "                targets = targets.to(device, non_blocking=True)\n",
    "\n",
    "                logits = model(images)\n",
    "                loss = criterion(logits, targets)\n",
    "\n",
    "                validation_loss_total += loss.item() * len(targets)\n",
    "                validation_examples += len(targets)\n",
    "\n",
    "        train_loss = train_loss_total / train_examples\n",
    "        validation_loss = validation_loss_total / validation_examples\n",
    "\n",
    "        fold_history.append({\n",
    "            \"epoch\": epoch,\n",
    "            \"train_loss\": train_loss,\n",
    "            \"validation_loss\": validation_loss\n",
    "        })\n",
    "\n",
    "        if validation_loss < best_validation_loss:\n",
    "            best_validation_loss = validation_loss\n",
    "            best_state = copy.deepcopy(model.state_dict())\n",
    "            best_epoch = epoch\n",
    "            epochs_without_improvement = 0\n",
    "        else:\n",
    "            epochs_without_improvement += 1\n",
    "\n",
    "        if epochs_without_improvement >= PATIENCE:\n",
    "            break\n",
    "\n",
    "    assert best_state is not None\n",
    "    model.load_state_dict(best_state)\n",
    "    model.eval()\n",
    "\n",
    "    # Generate predictions only after model selection is complete.\n",
    "    test_probabilities = []\n",
    "\n",
    "    with torch.no_grad():\n",
    "        for images, _ in test_loader:\n",
    "            images = images.to(device, non_blocking=True)\n",
    "            logits = model(images)\n",
    "            probabilities = torch.softmax(logits, dim=1)\n",
    "            test_probabilities.append(probabilities.cpu().numpy())\n",
    "\n",
    "    test_probabilities = np.concatenate(test_probabilities, axis=0)\n",
    "\n",
    "    fold_predictions = test_frame[\n",
    "        [\"file_id\", \"label\", \"outer_fold\", \"group_id\"]\n",
    "    ].reset_index(drop=True).copy()\n",
    "\n",
    "    fold_predictions[\"p_normal\"] = test_probabilities[:, 0]\n",
    "    fold_predictions[\"p_celiac\"] = test_probabilities[:, 1]\n",
    "    fold_predictions[\"predicted_label\"] = np.where(\n",
    "        fold_predictions[\"p_normal\"] >= 0.50,\n",
    "        \"Normal\",\n",
    "        \"Celiac\"\n",
    "    )\n",
    "\n",
    "    all_oof_predictions.append(fold_predictions)\n",
    "\n",
    "    torch.save(\n",
    "        {\n",
    "            \"model_state_dict\": best_state,\n",
    "            \"outer_fold\": outer_fold,\n",
    "            \"best_epoch\": best_epoch,\n",
    "            \"best_validation_loss\": best_validation_loss,\n",
    "            \"seed\": SEED,\n",
    "            \"protocol\": \"ResNet-18, layer4 + head fine-tuning\"\n",
    "        },\n",
    "        MODEL_DIR / f\"resnet18_outer_fold_{outer_fold}.pt\"\n",
    "    )\n",
    "\n",
    "    with open(MODEL_DIR / f\"training_history_fold_{outer_fold}.json\", \"w\") as f:\n",
    "        json.dump(fold_history, f, indent=2)\n",
    "\n",
    "    training_records.append({\n",
    "        \"outer_fold\": outer_fold,\n",
    "        \"train_images\": len(inner_train),\n",
    "        \"validation_images\": len(validation),\n",
    "        \"heldout_images\": len(test_frame),\n",
    "        \"best_epoch\": best_epoch,\n",
    "        \"best_validation_loss\": best_validation_loss\n",
    "    })\n",
    "\n",
    "    del model, optimizer\n",
    "    torch.cuda.empty_cache()\n",
    "\n",
    "oof_predictions = (\n",
    "    pd.concat(all_oof_predictions, ignore_index=True)\n",
    "    .sort_values(\"file_id\")\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "assert len(oof_predictions) == 159\n",
    "assert oof_predictions[\"file_id\"].is_unique\n",
    "assert oof_predictions[\"p_normal\"].between(0, 1).all()\n",
    "assert oof_predictions[\"p_celiac\"].between(0, 1).all()\n",
    "\n",
    "oof_predictions.to_csv(\n",
    "    WORK / \"frozen_oof_predictions.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "with open(WORK / \"training_records.json\", \"w\") as f:\n",
    "    json.dump(training_records, f, indent=2)\n",
    "\n",
    "print(\"\\nTraining complete.\")\n",
    "print(f\"Saved out-of-fold predictions: {WORK / 'frozen_oof_predictions.csv'}\")\n",
    "print(f\"Saved five fold models: {MODEL_DIR}\")"
