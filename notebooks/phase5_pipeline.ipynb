  "cell_type": "code",
  "source": [
    "# Milestone 6: fair comparison of four ranking methods\n",
    "\n",
    "import math\n",
    "from pathlib import Path\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "import pandas as pd\n",
    "\n",
    "\n",
    "WORK = Path(\"/content/celiac_reliability_phase5\")\n",
    "\n",
    "scores = pd.read_csv(\n",
    "    WORK / \"frozen_review_scores_predicted_normal.csv\"\n",
    ")\n",
    "\n",
    "assert len(scores) == 84\n",
    "assert scores[\"file_id\"].is_unique\n",
    "\n",
    "# Reconstruct four ranking scores.\n",
    "\n",
    "# 1. Confidence alone:\n",
    "# weaker confidence in a Normal prediction gets higher priority.\n",
    "scores[\"confidence_alone\"] = (\n",
    "    1.0 - scores[\"p_normal\"]\n",
    ")\n",
    "\n",
    "# 2. Quality alone:\n",
    "# larger values indicate worse technical quality.\n",
    "scores[\"quality_alone\"] = scores[\n",
    "    [\n",
    "        \"blur_proxy\",\n",
    "        \"extreme_exposure_fraction\",\n",
    "        \"glare_fraction\",\n",
    "    ]\n",
    "].rank(\n",
    "    method=\"average\",\n",
    "    pct=True,\n",
    ").mean(axis=1)\n",
    "\n",
    "# 3. Instability alone:\n",
    "# larger probability changes get higher priority.\n",
    "scores[\"instability_alone\"] = scores[\n",
    "    \"instability_mean_abs_change\"\n",
    "].rank(\n",
    "    method=\"average\",\n",
    "    pct=True,\n",
    ")\n",
    "\n",
    "# 4. Combined method:\n",
    "# equal-weight average of the three percentile rankings.\n",
    "scores[\"combined_method\"] = scores[\n",
    "    [\n",
    "        \"confidence_priority_percentile\",\n",
    "        \"instability_percentile\",\n",
    "        \"technical_quality_percentile\",\n",
    "    ]\n",
    "].mean(axis=1)\n",
    "\n",
    "\n",
    "def select_top_k(frame, score_column, k):\n",
    "    return frame.sort_values(\n",
    "        [\n",
    "            score_column,\n",
    "            \"file_id\",\n",
    "        ],\n",
    "        ascending=[\n",
    "            False,\n",
    "            True,\n",
    "        ],\n",
    "        kind=\"mergesort\",\n",
    "    ).head(k)\n",
    "\n",
    "\n",
    "N = len(scores)\n",
    "\n",
    "total_false_normals = int(\n",
    "    (scores[\"label\"] == \"Celiac\").sum()\n",
    ")\n",
    "\n",
    "result_rows = []\n",
    "\n",
    "for review_rate in [\n",
    "    0.10,\n",
    "    0.20,\n",
    "    0.30,\n",
    "]:\n",
    "\n",
    "    K = math.ceil(\n",
    "        review_rate * N\n",
    "    )\n",
    "\n",
    "    methods = [\n",
    "        (\n",
    "            \"Confidence alone\",\n",
    "            \"confidence_alone\",\n",
    "        ),\n",
    "        (\n",
    "            \"Quality alone\",\n",
    "            \"quality_alone\",\n",
    "        ),\n",
    "        (\n",
    "            \"Instability alone\",\n",
    "            \"instability_alone\",\n",
    "        ),\n",
    "        (\n",
    "            \"Combined method\",\n",
    "            \"combined_method\",\n",
    "        ),\n",
    "    ]\n",
    "\n",
    "    for method_name, score_column in methods:\n",
    "\n",
    "        selected = select_top_k(\n",
    "            scores,\n",
    "            score_column,\n",
    "            K,\n",
    "        )\n",
    "\n",
    "        false_normals_caught = int(\n",
    "            (selected[\"label\"] == \"Celiac\").sum()\n",
    "        )\n",
    "\n",
    "        correct_normals_flagged = int(\n",
    "            (selected[\"label\"] == \"Normal\").sum()\n",
    "        )\n",
    "\n",
    "        false_normals_left_unflagged = (\n",
    "            total_false_normals\n",
    "            - false_normals_caught\n",
    "        )\n",
    "\n",
    "        result_rows.append(\n",
    "            {\n",
    "                \"review_rate\": review_rate,\n",
    "                \"review_rate_percent\": (\n",
    "                    review_rate * 100\n",
    "                ),\n",
    "                \"flagged_predicted_normal_images\": K,\n",
    "                \"method\": method_name,\n",
    "                \"false_normals_caught\": (\n",
    "                    false_normals_caught\n",
    "                ),\n",
    "                \"correct_normals_flagged\": (\n",
    "                    correct_normals_flagged\n",
    "                ),\n",
    "                \"false_normals_left_unflagged\": (\n",
    "                    false_normals_left_unflagged\n",
    "                ),\n",
    "                \"percent_of_false_normals_caught\": (\n",
    "                    false_normals_caught\n",
    "                    / total_false_normals\n",
    "                ),\n",
    "            }\n",
    "        )\n",
    "\n",
    "\n",
    "results = pd.DataFrame(result_rows)\n",
    "\n",
    "results.to_csv(\n",
    "    WORK / \"milestone6_four_method_results.csv\",\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "# Create the review-rate graph.\n",
    "plt.figure(figsize=(9, 6))\n",
    "\n",
    "for method_name, group in results.groupby(\n",
    "    \"method\"\n",
    "):\n",
    "\n",
    "    plt.plot(\n",
    "        group[\"review_rate_percent\"],\n",
    "        group[\"false_normals_caught\"],\n",
    "        marker=\"o\",\n",
    "        linewidth=2,\n",
    "        label=method_name,\n",
    "    )\n",
    "\n",
    "plt.xlabel(\n",
    "    \"Allowed review rate (%)\"\n",
    ")\n",
    "\n",
    "plt.ylabel(\n",
    "    \"False normals caught (count)\"\n",
    ")\n",
    "\n",
    "plt.title(\n",
    "    \"Milestone 6: Four Review-Ranking Methods\"\n",
    ")\n",
    "\n",
    "plt.xticks(\n",
    "    [\n",
    "        10,\n",
    "        20,\n",
    "        30,\n",
    "    ]\n",
    ")\n",
    "\n",
    "plt.grid(\n",
    "    alpha=0.3\n",
    ")\n",
    "\n",
    "plt.legend()\n",
    "plt.tight_layout()\n",
    "\n",
    "plt.savefig(\n",
    "    WORK / \"milestone6_four_method_review_curve.png\",\n",
    "    dpi=200,\n",
    ")\n",
    "\n",
    "plt.show()\n",
    "\n",
    "print(\"Milestone 6 comparison complete.\")\n",
    "print()\n",
    "print(results.to_string(index=False))\n",
    "print()\n",
    "print(\n",
    "    f\"Total false normals: {total_false_normals}\"\n",
    ")\n",
    "print(\n",
    "    \"Saved:\",\n",
    "    WORK / \"milestone6_four_method_results.csv\",\n",
    ")\n",
