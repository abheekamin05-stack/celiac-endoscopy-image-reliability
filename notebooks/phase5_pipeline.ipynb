    "# Generate prediction-instability and technical-quality features\n",
    "\n",
    "import io\n",
    "from pathlib import Path\n",
    "\n",
    "import cv2\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "from PIL import Image, ImageEnhance\n",
    "from torchvision import models, transforms\n",
    "\n",
    "\n",
    "WORK = Path(\"/content/celiac_reliability_phase5\")\n",
    "MODEL_DIR = WORK / \"models\"\n",
    "\n",
    "device = torch.device(\n",
    "    \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
    ")\n",
    "\n",
    "assignments = pd.read_csv(\n",
    "    WORK / \"frozen_fold_assignments.csv\"\n",
    ")\n",
    "\n",
    "oof = pd.read_csv(\n",
    "    WORK / \"frozen_oof_predictions.csv\"\n",
    ")\n",
    "\n",
    "assert len(assignments) == 159\n",
    "assert len(oof) == 159\n",
    "assert set(assignments[\"file_id\"]) == set(oof[\"file_id\"])\n",
    "\n",
    "preprocess = transforms.Compose(\n",
    "    [\n",
    "        transforms.Resize((224, 224)),\n",
    "        transforms.ToTensor(),\n",
    "        transforms.Normalize(\n",
    "            mean=[0.485, 0.456, 0.406],\n",
    "            std=[0.229, 0.224, 0.225],\n",
    "        ),\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "def build_model():\n",
    "    model = models.resnet18(weights=None)\n",
    "\n",
    "    for parameter in model.parameters():\n",
    "        parameter.requires_grad = False\n",
    "\n",
    "    for parameter in model.layer4.parameters():\n",
    "        parameter.requires_grad = True\n",
    "\n",
    "    model.fc = nn.Linear(\n",
    "        model.fc.in_features,\n",
    "        2,\n",
    "    )\n",
    "\n",
    "    return model.to(device)\n",
    "\n",
    "\n",
    "def load_fold_model(fold):\n",
    "    checkpoint = torch.load(\n",
    "        MODEL_DIR / f\"resnet18_outer_fold_{fold}.pt\",\n",
    "        map_location=device,\n",
    "    )\n",
    "\n",
    "    model = build_model()\n",
    "    model.load_state_dict(\n",
    "        checkpoint[\"model_state_dict\"]\n",
    "    )\n",
    "    model.eval()\n",
    "\n",
    "    return model\n",
    "\n",
    "\n",
    "def predict_p_normal(model, image):\n",
    "    tensor = preprocess(image)\n",
    "    tensor = tensor.unsqueeze(0).to(device)\n",
    "\n",
    "    with torch.no_grad():\n",
    "        probabilities = torch.softmax(\n",
    "            model(tensor),\n",
    "            dim=1,\n",
    "        )\n",
    "\n",
    "    return float(\n",
    "        probabilities[0, 0].cpu().item()\n",
    "    )\n",
    "\n",
    "\n",
    "def jpeg_recompress(image, quality):\n",
    "    buffer = io.BytesIO()\n",
    "\n",
    "    image.save(\n",
    "        buffer,\n",
    "        format=\"JPEG\",\n",
    "        quality=quality,\n",
    "    )\n",
    "\n",
    "    buffer.seek(0)\n",
    "\n",
    "    return Image.open(buffer).convert(\"RGB\")\n",
    "\n",
    "\n",
    "def technical_quality_features(image):\n",
    "    rgb = np.asarray(\n",
    "        image.convert(\"RGB\")\n",
    "    )\n",
    "\n",
    "    height, width = rgb.shape[:2]\n",
    "\n",
    "    x0 = int(round(0.20 * width))\n",
    "    x1 = int(round(0.80 * width))\n",
    "    y0 = int(round(0.20 * height))\n",
    "    y1 = int(round(0.80 * height))\n",
    "\n",
    "    central = rgb[y0:y1, x0:x1]\n",
    "\n",
    "    gray = cv2.cvtColor(\n",
    "        central,\n",
    "        cv2.COLOR_RGB2GRAY,\n",
    "    )\n",
    "\n",
    "    laplacian_variance = float(\n",
    "        cv2.Laplacian(\n",
    "            gray,\n",
    "            cv2.CV_64F,\n",
    "        ).var()\n",
    "    )\n",
    "\n",
    "    blur_proxy = 1.0 / (\n",
    "        1.0 + laplacian_variance\n",
    "    )\n",
    "\n",
    "    extreme_exposure_fraction = float(\n",
    "        np.mean(\n",
    "            (gray < 20) | (gray > 235)\n",
    "        )\n",
    "    )\n",
    "\n",
    "    glare_fraction = float(\n",
    "        np.mean(\n",
    "            np.all(central > 245, axis=2)\n",
    "        )\n",
    "    )\n",
    "\n",
    "    return {\n",
    "        \"blur_proxy\": blur_proxy,\n",
    "        \"extreme_exposure_fraction\": (\n",
    "            extreme_exposure_fraction\n",
    "        ),\n",
    "        \"glare_fraction\": glare_fraction,\n",
    "    }\n",
    "\n",
    "\n",
    "fold_models = {\n",
    "    fold: load_fold_model(fold)\n",
    "    for fold in range(1, 6)\n",
    "}\n",
    "\n",
    "feature_rows = []\n",
    "\n",
    "for _, row in assignments.sort_values(\n",
    "    \"file_id\"\n",
    ").iterrows():\n",
    "\n",
    "    image = Image.open(\n",
    "        row[\"working_path\"]\n",
    "    ).convert(\"RGB\")\n",
    "\n",
    "    model = fold_models[\n",
    "        int(row[\"outer_fold\"])\n",
    "    ]\n",
    "\n",
    "    original_p_normal = predict_p_normal(\n",
    "        model,\n",
    "        image,\n",
    "    )\n",
    "\n",
    "    transformed_images = {\n",
    "        \"brightness_090\": (\n",
    "            ImageEnhance.Brightness(image)\n",
    "            .enhance(0.90)\n",
    "        ),\n",
    "        \"brightness_110\": (\n",
    "            ImageEnhance.Brightness(image)\n",
    "            .enhance(1.10)\n",
    "        ),\n",
    "        \"jpeg_quality_75\": jpeg_recompress(\n",
    "            image,\n",
    "            75,\n",
    "        ),\n",
    "        \"jpeg_quality_90\": jpeg_recompress(\n",
    "            image,\n",
    "            90,\n",
    "        ),\n",
    "    }\n",
    "\n",
    "    transformed_p_normal = {\n",
    "        name: predict_p_normal(\n",
    "            model,\n",
    "            transformed,\n",
    "        )\n",
    "        for name, transformed in (\n",
    "            transformed_images.items()\n",
    "        )\n",
    "    }\n",
    "\n",
    "    shifts = [\n",
    "        abs(\n",
    "            value - original_p_normal\n",
    "        )\n",
    "        for value in transformed_p_normal.values()\n",
    "    ]\n",
    "\n",
    "    quality = technical_quality_features(\n",
    "        image\n",
    "    )\n",
    "\n",
    "    feature_rows.append(\n",
    "        {\n",
    "            \"file_id\": row[\"file_id\"],\n",
    "            \"outer_fold\": int(\n",
    "                row[\"outer_fold\"]\n",
    "            ),\n",
    "            \"p_normal_original_recomputed\": (\n",
    "                original_p_normal\n",
    "            ),\n",
    "            \"p_normal_brightness_090\": (\n",
    "                transformed_p_normal[\n",
    "                    \"brightness_090\"\n",
    "                ]\n",
    "            ),\n",
    "            \"p_normal_brightness_110\": (\n",
    "                transformed_p_normal[\n",
    "                    \"brightness_110\"\n",
    "                ]\n",
    "            ),\n",
    "            \"p_normal_jpeg_quality_75\": (\n",
    "                transformed_p_normal[\n",
    "                    \"jpeg_quality_75\"\n",
    "                ]\n",
    "            ),\n",
    "            \"p_normal_jpeg_quality_90\": (\n",
    "                transformed_p_normal[\n",
    "                    \"jpeg_quality_90\"\n",
    "                ]\n",
    "            ),\n",
    "            \"instability_mean_abs_change\": float(\n",
    "                np.mean(shifts)\n",
    "            ),\n",
    "            **quality,\n",
    "        }\n",
    "    )\n",
    "\n",
    "features = pd.DataFrame(\n",
    "    feature_rows\n",
    ")\n",
    "\n",
    "features = (\n",
    "    oof[\n",
    "        [\n",
    "            \"file_id\",\n",
    "            \"label\",\n",
    "            \"predicted_label\",\n",
    "            \"p_normal\",\n",
    "            \"p_celiac\",\n",
    "        ]\n",
    "    ]\n",
    "    .merge(\n",
    "        features,\n",
    "        on=\"file_id\",\n",
    "        validate=\"one_to_one\",\n",
    "    )\n",
    "    .sort_values(\"file_id\")\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "assert len(features) == 159\n",
    "assert features[\"file_id\"].is_unique\n",
    "assert features[\n",
    "    \"instability_mean_abs_change\"\n",
    "].ge(0).all()\n",
    "assert features[\"blur_proxy\"].ge(0).all()\n",
    "assert features[\n",
    "    \"extreme_exposure_fraction\"\n",
    "].between(0, 1).all()\n",
    "assert features[\n",
    "    \"glare_fraction\"\n",
    "].between(0, 1).all()\n",
    "\n",
    "features.to_csv(\n",
    "    WORK / \"frozen_reliability_features.csv\",\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "print(\"Feature generation complete.\")\n",
    "print(\n",
    "    f\"Saved: {WORK / 'frozen_reliability_features.csv'}\"\n",
    ")\n",
    "print(f\"Rows saved: {len(features)}\")"
  ],
