{
  "cell_type": "code",
  "source": [
    "# Milestone 6: four fair rankings on the same frozen held-out predictions\n",
    "import math\n",
    "from pathlib import Path\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "WORK = Path(\"/content/celiac_reliability_phase5\")\n",
    "features = pd.read_csv(WORK / \"frozen_reliability_features.csv\")\n",
    "scores = features.loc[features[\"predicted_label\"] == \"Normal\"].copy()\n",
    "assert len(scores) == 86\n",
    "\n",
    "# Larger values mean greater review priority for every method.\n",
    "scores[\"confidence_only\"] = 1.0 - scores[\"p_normal\"]\n",
    "scores[\"quality_only\"] = scores[[\"blur_proxy\", \"extreme_exposure_fraction\", \"glare_fraction\"]].rank(pct=True).mean(axis=1)\n",
    "scores[\"instability_only\"] = scores[\"instability_mean_abs_change\"].rank(pct=True)\n",
    "scores[\"combined_method\"] = scores[[\"confidence_only\", \"quality_only\", \"instability_only\"]].rank(pct=True).mean(axis=1)\n",
    "\n",
    "def top(frame, col, k):\n",
    "    return frame.sort_values([col, \"file_id\"], ascending=[False, True], kind=\"mergesort\").head(k)\n",
    "\n",
    "rows = []\n",
    "N = len(scores)\n",
    "F = int((scores[\"label\"] == \"Celiac\").sum())\n",
    "for rate in [0.10, 0.20, 0.30]:\n",
    "    k = math.ceil(rate * N)\n",
    "    for method, col in [\n",
    "        (\"Confidence alone\", \"confidence_only\"),\n",
    "        (\"Quality alone\", \"quality_only\"),\n",
    "        (\"Instability alone\", \"instability_only\"),\n",
    "        (\"Combined method\", \"combined_method\"),\n",
    "    ]:\n",
    "        selected = top(scores, col, k)\n",
    "        caught = int((selected[\"label\"] == \"Celiac\").sum())\n",
    "        correct_normals = int((selected[\"label\"] == \"Normal\").sum())\n",
    "        rows.append({\n",
    "            \"review_rate\": rate,\n",
    "            \"flagged_predicted_normal_images\": k,\n",
    "            \"method\": method,\n",
    "            \"false_normals_caught\": caught,\n",
    "            \"correct_normals_flagged\": correct_normals,\n",
    "            \"false_normals_left_unflagged\": F - caught,\n",
    "            \"percent_of_false_normals_caught\": caught / F,\n",
    "        })\n",
    "\n",
    "table = pd.DataFrame(rows)\n",
    "table.to_csv(WORK / \"milestone6_four_method_results.csv\", index=False)\n",
    "\n",
    "plt.figure(figsize=(8, 5))\n",
    "for method, group in table.groupby(\"method\"):\n",
    "    plt.plot(group[\"review_rate\"] * 100, group[\"false_normals_caught\"], marker=\"o\", label=method)\n",
    "plt.xlabel(\"Allowed review rate (%)\")\n",
    "plt.ylabel(\"False normals caught (count)\")\n",
    "plt.xticks([10, 20, 30])\n",
    "plt.grid(alpha=0.3)\n",
    "plt.legend()\n",
    "plt.tight_layout()\n",
    "plt.savefig(WORK / \"milestone6_four_method_review_curve.png\", dpi=180)\n",
    "plt.show()\n",
    "\n",
    "print(table.to_string(index=False))\n",
    "print(\"Saved:\", WORK / \"milestone6_four_method_results.csv\")\n",
    "print(\"Saved:\", WORK / \"milestone6_four_method_review_curve.png\")\n"
  ],
  "metadata": {
    "id": "o8R4ABWdoZYr"
  },
