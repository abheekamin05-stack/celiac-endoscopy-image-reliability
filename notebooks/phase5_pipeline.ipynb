{
  "cell_type": "code",
  "source": [
    "# Score and evaluate the central-field crop sensitivity analysis.\n",
    "\n",
    "import io\n",
    "import json\n",
    "import math\n",
    "from pathlib import Path\n",
    "\n",
    "import cv2\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "from PIL import Image, ImageEnhance\n",
    "from torchvision import models, transforms\n",
    "\n",
    "WORK = Path(\"/content/celiac_reliability_phase5\")\n",
    "MODEL_DIR = WORK / \"central_field_crop_models\"\n",
    "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "\n",
    "assignments = pd.read_csv(WORK / \"frozen_fold_assignments.csv\")\n",
    "crop_oof = pd.read_csv(WORK / \"central_field_crop_oof_predictions.csv\")\n",
    "\n",
    "assert len(assignments) == 159\n",
    "assert len(crop_oof) == 159\n",
    "assert crop_oof[\"file_id\"].is_unique\n",
    "\n",
    "def central_field_crop(image):\n",
    "    width, height = image.size\n",
    "    crop_width = int(round(0.80 * width))\n",
    "    crop_height = int(round(0.70 * height))\n",
    "    left = (width - crop_width) // 2\n",
    "    top = (height - crop_height) // 2\n",
    "    return image.crop((left, top, left + crop_width, top + crop_height))\n",
    "\n",
    "preprocess = transforms.Compose([\n",
    "    transforms.Resize(\n",
    "        (224, 224),\n",
    "        interpolation=transforms.InterpolationMode.BILINEAR,\n",
    "    ),\n",
    "    transforms.ToTensor(),\n",
    "    transforms.Normalize(\n",
    "        mean=[0.485, 0.456, 0.406],\n",
    "        std=[0.229, 0.224, 0.225],\n",
    "    ),\n",
    "])\n",
    "\n",
    "def build_model():\n",
    "    model = models.resnet18(weights=None)\n",
    "\n",
    "    for parameter in model.parameters():\n",
    "        parameter.requires_grad = False\n",
    "\n",
    "    for parameter in model.layer4.parameters():\n",
    "        parameter.requires_grad = True\n",
    "\n",
    "    model.fc = nn.Linear(model.fc.in_features, 2)\n",
    "    return model.to(device)\n",
    "\n",
    "def load_fold_model(fold):\n",
    "    checkpoint = torch.load(\n",
    "        MODEL_DIR / f\"central_crop_resnet18_outer_fold_{fold}.pt\",\n",
    "        map_location=device,\n",
    "    )\n",
    "    model = build_model()\n",
    "    model.load_state_dict(checkpoint[\"model_state_dict\"])\n",
    "    model.eval()\n",
    "    return model\n",
    "\n",
    "def predict_p_normal(model, image):\n",
    "    tensor = preprocess(image).unsqueeze(0).to(device)\n",
    "    with torch.no_grad():\n",
    "        probabilities = torch.softmax(model(tensor), dim=1)\n",
    "    return float(probabilities[0, 0].cpu().item())\n",
    "\n",
    "def jpeg_recompress(image, quality):\n",
    "    buffer = io.BytesIO()\n",
    "    image.save(buffer, format=\"JPEG\", quality=quality)\n",
    "    buffer.seek(0)\n",
    "    return Image.open(buffer).convert(\"RGB\")\n",
    "\n",
    "def technical_quality_features(image):\n",
    "    rgb = np.asarray(image.convert(\"RGB\"))\n",
    "    height, width = rgb.shape[:2]\n",
    "\n",
    "    # Same quality measurement rule: central 60% of the crop image.\n",
    "    x0, x1 = int(round(0.20 * width)), int(round(0.80 * width))\n",
    "    y0, y1 = int(round(0.20 * height)), int(round(0.80 * height))\n",
    "\n",
    "    central = rgb[y0:y1, x0:x1]\n",
    "    gray = cv2.cvtColor(central, cv2.COLOR_RGB2GRAY)\n",
    "\n",
    "    laplacian_variance = float(cv2.Laplacian(gray, cv2.CV_64F).var())\n",
    "\n",
    "    return {\n",
    "        \"blur_proxy\": 1.0 / (1.0 + laplacian_variance),\n",
    "        \"extreme_exposure_fraction\": float(\n",
    "            np.mean((gray < 20) | (gray > 235))\n",
    "        ),\n",
    "        \"glare_fraction\": float(\n",
    "            np.mean(np.all(central > 245, axis=2))\n",
    "        ),\n",
    "    }\n",
    "\n",
    "fold_models = {\n",
    "    fold: load_fold_model(fold)\n",
    "    for fold in range(1, 6)\n",
    "}\n",
    "\n",
    "feature_rows = []\n",
    "\n",
    "for _, row in assignments.sort_values(\"file_id\").iterrows():\n",
    "    original = Image.open(row[\"working_path\"]).convert(\"RGB\")\n",
    "    image = central_field_crop(original)\n",
    "    model = fold_models[int(row[\"outer_fold\"])]\n",
    "\n",
    "    original_p_normal = predict_p_normal(model, image)\n",
    "\n",
    "    transformed_images = {\n",
    "        \"brightness_090\": ImageEnhance.Brightness(image).enhance(0.90),\n",
    "        \"brightness_110\": ImageEnhance.Brightness(image).enhance(1.10),\n",
    "        \"jpeg_quality_75\": jpeg_recompress(image, 75),\n",
    "        \"jpeg_quality_90\": jpeg_recompress(image, 90),\n",
    "    }\n",
    "\n",
    "    transformed_p_normal = {\n",
    "        name: predict_p_normal(model, transformed)\n",
    "        for name, transformed in transformed_images.items()\n",
    "    }\n",
    "\n",
    "    quality = technical_quality_features(image)\n",
    "\n",
    "    feature_rows.append({\n",
    "        \"file_id\": row[\"file_id\"],\n",
    "        \"outer_fold\": int(row[\"outer_fold\"]),\n",
    "        \"p_normal_original_recomputed\": original_p_normal,\n",
    "        \"p_normal_brightness_090\": transformed_p_normal[\"brightness_090\"],\n",
    "        \"p_normal_brightness_110\": transformed_p_normal[\"brightness_110\"],\n",
    "        \"p_normal_jpeg_quality_75\": transformed_p_normal[\"jpeg_quality_75\"],\n",
    "        \"p_normal_jpeg_quality_90\": transformed_p_normal[\"jpeg_quality_90\"],\n",
    "        \"instability_mean_abs_change\": float(np.mean([\n",
    "            abs(value - original_p_normal)\n",
    "            for value in transformed_p_normal.values()\n",
    "        ])),\n",
    "        **quality,\n",
    "    })\n",
    "\n",
    "crop_features = pd.DataFrame(feature_rows).merge(\n",
    "    crop_oof[\n",
    "        [\n",
    "            \"file_id\",\n",
    "            \"label\",\n",
    "            \"group_id\",\n",
    "            \"p_normal\",\n",
    "            \"p_celiac\",\n",
    "            \"predicted_label\",\n",
    "        ]\n",
    "    ],\n",
    "    on=\"file_id\",\n",
    "    validate=\"one_to_one\",\n",
    ").sort_values(\"file_id\").reset_index(drop=True)\n",
    "\n",
    "crop_features.to_csv(\n",
    "    WORK / \"central_field_crop_reliability_features.csv\",\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "# Recreate the same frozen review score construction.\n",
    "scores = crop_features.loc[\n",
    "    crop_features[\"predicted_label\"] == \"Normal\"\n",
    "].copy()\n",
    "\n",
    "scores[\"confidence_priority_percentile\"] = (\n",
    "    1.0 - scores[\"p_normal\"].rank(\n",
    "        method=\"average\",\n",
    "        pct=True,\n",
    "        ascending=True,\n",
    "    )\n",
    ")\n",
    "\n",
    "scores[\"instability_percentile\"] = scores[\n",
    "    \"instability_mean_abs_change\"\n",
    "].rank(method=\"average\", pct=True, ascending=True)\n",
    "\n",
    "quality_percentile_columns = []\n",
    "\n",
    "for column in [\n",
    "    \"blur_proxy\",\n",
    "    \"extreme_exposure_fraction\",\n",
    "    \"glare_fraction\",\n",
    "]:\n",
    "    percentile_column = f\"{column}_percentile\"\n",
    "    scores[percentile_column] = scores[column].rank(\n",
    "        method=\"average\",\n",
    "        pct=True,\n",
    "        ascending=True,\n",
    "    )\n",
    "    quality_percentile_columns.append(percentile_column)\n",
    "\n",
    "scores[\"technical_quality_percentile\"] = scores[\n",
    "    quality_percentile_columns\n",
    "].mean(axis=1)\n",
    "\n",
    "scores[\"combined_review_priority\"] = scores[\n",
    "    [\n",
    "        \"confidence_priority_percentile\",\n",
    "        \"instability_percentile\",\n",
    "        \"technical_quality_percentile\",\n",
    "    ]\n",
    "].mean(axis=1)\n",
    "\n",
    "def select_top_k(frame, score_column, k):\n",
    "    return frame.sort_values(\n",
    "        [score_column, \"file_id\"],\n",
    "        ascending=[False, True],\n",
    "        kind=\"mergesort\",\n",
    "    ).head(k)\n",
    "\n",
    "def selection_summary(selected, total_events, population_size):\n",
    "    caught = int((selected[\"label\"] == \"Celiac\").sum())\n",
    "\n",
    "    return {\n",
    "        \"flagged\": int(len(selected)),\n",
    "        \"target_events_caught\": caught,\n",
    "        \"normal_alerts\": int((selected[\"label\"] == \"Normal\").sum()),\n",
    "        \"capture_among_target_events\": (\n",
    "            caught / total_events if total_events else None\n",
    "        ),\n",
    "        \"flagged_event_fraction\": caught / len(selected),\n",
    "        \"actual_review_percentage\": len(selected) / population_size,\n",
    "    }\n",
    "\n",
    "N = len(scores)\n",
    "F = int((scores[\"label\"] == \"Celiac\").sum())\n",
    "\n",
    "comparisons = {}\n",
    "\n",
    "for rate in [0.10, 0.20, 0.30]:\n",
    "    k = math.ceil(rate * N)\n",
    "\n",
    "    confidence_selected = select_top_k(\n",
    "        scores,\n",
    "        \"confidence_priority_percentile\",\n",
    "        k,\n",
    "    )\n",
    "\n",
    "    combined_selected = select_top_k(\n",
    "        scores,\n",
    "        \"combined_review_priority\",\n",
    "        k,\n",
    "    )\n",
    "\n",
    "    confidence_summary = selection_summary(\n",
    "        confidence_selected,\n",
    "        F,\n",
    "        N,\n",
    "    )\n",
    "    combined_summary = selection_summary(\n",
    "        combined_selected,\n",
    "        F,\n",
    "        N,\n",
    "    )\n",
    "\n",
    "    comparisons[str(rate)] = {\n",
    "        \"requested_rate\": rate,\n",
    "        \"K\": k,\n",
    "        \"confidence_only\": confidence_summary,\n",
    "        \"combined\": combined_summary,\n",
    "        \"paired_difference_combined_minus_confidence\": (\n",
    "            combined_summary[\"target_events_caught\"]\n",
    "            - confidence_summary[\"target_events_caught\"]\n",
    "        ),\n",
    "        \"flagged_set_overlap\": int(\n",
    "            len(\n",
    "                set(confidence_selected[\"file_id\"])\n",
    "                & set(combined_selected[\"file_id\"])\n",
    "            )\n",
    "        ),\n",
    "    }\n",
    "\n",
    "# Crop-model confusion counts and image-level sensitivity/specificity.\n",
    "confusion = pd.crosstab(\n",
    "    crop_features[\"label\"],\n",
    "    crop_features[\"predicted_label\"],\n",
    ").reindex(\n",
    "    index=[\"Normal\", \"Celiac\"],\n",
    "    columns=[\"Normal\", \"Celiac\"],\n",
    "    fill_value=0,\n",
    ")\n",
    "\n",
    "true_normal = int(confusion.loc[\"Normal\"].sum())\n",
    "true_celiac = int(confusion.loc[\"Celiac\"].sum())\n",
    "\n",
    "sensitivity = (\n",
    "    int(confusion.loc[\"Celiac\", \"Celiac\"]) / true_celiac\n",
    ")\n",
    "specificity = (\n",
    "    int(confusion.loc[\"Normal\", \"Normal\"]) / true_normal\n",
    ")\n",
    "\n",
    "# Compare both models across the audit's visible-overlay/layout categories.\n",
    "original_oof = pd.read_csv(WORK / \"frozen_oof_predictions.csv\")\n",
    "\n",
    "layout_comparison = (\n",
    "    assignments[\n",
    "        [\"file_id\", \"visible_overlay_style\"]\n",
    "    ]\n",
    "    .merge(\n",
    "        original_oof[\n",
    "            [\"file_id\", \"label\", \"predicted_label\"]\n",
    "        ].rename(columns={\"predicted_label\": \"original_prediction\"}),\n",
    "        on=\"file_id\",\n",
    "        validate=\"one_to_one\",\n",
    "    )\n",
    "    .merge(\n",
    "        crop_oof[\n",
    "            [\"file_id\", \"predicted_label\"]\n",
    "        ].rename(columns={\"predicted_label\": \"crop_prediction\"}),\n",
    "        on=\"file_id\",\n",
    "        validate=\"one_to_one\",\n",
    "    )\n",
    ")\n",
    "\n",
    "layout_comparison[\"visible_overlay_style\"] = (\n",
    "    layout_comparison[\"visible_overlay_style\"]\n",
    "    .fillna(\"Not recorded\")\n",
    "    .astype(str)\n",
    ")\n",
    "\n",
    "layout_comparison[\"original_error\"] = (\n",
    "    layout_comparison[\"original_prediction\"]\n",
    "    != layout_comparison[\"label\"]\n",
    ")\n",
    "\n",
    "layout_comparison[\"crop_error\"] = (\n",
    "    layout_comparison[\"crop_prediction\"]\n",
    "    != layout_comparison[\"label\"]\n",
    ")\n",
    "\n",
    "layout_comparison[\"original_false_normal\"] = (\n",
    "    (layout_comparison[\"label\"] == \"Celiac\")\n",
    "    & (layout_comparison[\"original_prediction\"] == \"Normal\")\n",
    ")\n",
    "\n",
    "layout_comparison[\"crop_false_normal\"] = (\n",
    "    (layout_comparison[\"label\"] == \"Celiac\")\n",
    "    & (layout_comparison[\"crop_prediction\"] == \"Normal\")\n",
    ")\n",
    "\n",
    "layout_summary = (\n",
    "    layout_comparison\n",
    "    .groupby(\"visible_overlay_style\", dropna=False)\n",
    "    .agg(\n",
    "        images=(\"file_id\", \"size\"),\n",
    "        original_errors=(\"original_error\", \"sum\"),\n",
    "        crop_errors=(\"crop_error\", \"sum\"),\n",
    "        original_false_normals=(\"original_false_normal\", \"sum\"),\n",
    "        crop_false_normals=(\"crop_false_normal\", \"sum\"),\n",
    "    )\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "layout_summary[\"original_error_rate\"] = (\n",
    "    layout_summary[\"original_errors\"] / layout_summary[\"images\"]\n",
    ")\n",
    "\n",
    "layout_summary[\"crop_error_rate\"] = (\n",
    "    layout_summary[\"crop_errors\"] / layout_summary[\"images\"]\n",
    ")\n",
    "\n",
    "# Inspect full-image quality proxies by supplied label and layout category.\n",
    "original_features = pd.read_csv(\n",
    "    WORK / \"frozen_reliability_features.csv\"\n",
    ")\n",
    "\n",
    "quality_by_label_layout = (\n",
    "    original_features[\n",
    "        [\n",
    "            \"file_id\",\n",
    "            \"label\",\n",
    "            \"blur_proxy\",\n",
    "            \"extreme_exposure_fraction\",\n",
    "            \"glare_fraction\",\n",
    "        ]\n",
    "    ]\n",
    "    .merge(\n",
    "        assignments[[\"file_id\", \"visible_overlay_style\"]],\n",
    "        on=\"file_id\",\n",
    "        validate=\"one_to_one\",\n",
    "    )\n",
    ")\n",
    "\n",
    "quality_by_label_layout[\"visible_overlay_style\"] = (\n",
    "    quality_by_label_layout[\"visible_overlay_style\"]\n",
    "    .fillna(\"Not recorded\")\n",
    "    .astype(str)\n",
    ")\n",
    "\n",
    "quality_summary = (\n",
    "    quality_by_label_layout\n",
    "    .groupby([\"label\", \"visible_overlay_style\"])\n",
    "    .agg(\n",
    "        images=(\"file_id\", \"size\"),\n",
    "        blur_proxy_median=(\"blur_proxy\", \"median\"),\n",
    "        exposure_fraction_median=(\n",
    "            \"extreme_exposure_fraction\", \"median\"\n",
    "        ),\n",
    "        glare_fraction_median=(\"glare_fraction\", \"median\"),\n",
    "    )\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "scores.sort_values(\"file_id\").to_csv(\n",
    "    WORK / \"central_field_crop_review_scores_predicted_normal.csv\",\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "layout_summary.to_csv(\n",
    "    WORK / \"central_field_crop_layout_error_comparison.csv\",\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "quality_summary.to_csv(\n",
    "    WORK / \"full_image_quality_by_label_and_layout.csv\",\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "results = {\n",
    "    \"n_predicted_normal\": N,\n",
    "    \"celiac_labeled_among_predicted_normal\": F,\n",
    "    \"comparisons\": comparisons,\n",
    "    \"confusion_counts\": {\n",
    "        true_label: {\n",
    "            predicted_label: int(confusion.loc[true_label, predicted_label])\n",
    "            for predicted_label in confusion.columns\n",
    "        }\n",
    "        for true_label in confusion.index\n",
    "    },\n",
    "    \"sensitivity\": sensitivity,\n",
    "    \"specificity\": specificity,\n",
    "}\n",
    "\n",
    "with open(\n",
    "    WORK / \"central_field_crop_sensitivity_results.json\",\n",
    "    \"w\",\n",
    ") as file:\n",
    "    json.dump(results, file, indent=2)\n",
    "\n",
    "print(\"Central-field crop sensitivity analysis complete.\\n\")\n",
    "print(f\"Predicted-Normal images: {N}\")\n",
    "print(f\"Celiac-labeled images among them: {F}\\n\")\n",
    "\n",
    "for rate in [0.10, 0.20, 0.30]:\n",
    "    result = comparisons[str(rate)]\n",
    "    print(f\"{int(rate * 100)}% review rate, K={result['K']}\")\n",
    "    print(\n",
    "        \"  Confidence-only:\",\n",
    "        result[\"confidence_only\"][\"target_events_caught\"],\n",
    "        \"target events caught\",\n",
    "    )\n",
    "    print(\n",
    "        \"  Combined:\",\n",
    "        result[\"combined\"][\"target_events_caught\"],\n",
    "        \"target events caught\",\n",
    "    )\n",
    "    print(\n",
    "        \"  Difference:\",\n",
    "        result[\"paired_difference_combined_minus_confidence\"],\n",
    "    )\n",
    "    print()\n",
    "\n",
    "print(\"Crop-model confusion counts:\")\n",
    "print(confusion)\n",
    "\n",
    "print(f\"\\nCrop sensitivity: {sensitivity:.3f}\")\n",
    "print(f\"Crop specificity: {specificity:.3f}\")\n",
    "\n",
    "print(\"\\nErrors by audited layout category:\")\n",
    "print(layout_summary.to_string(index=False))\n",
    "\n",
    "print(\"\\nSaved:\", WORK / \"central_field_crop_sensitivity_results.json\")"
  ],
