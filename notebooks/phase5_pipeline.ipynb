{
  "cell_type": "code",
  "source": [
    "# Phase 5 closeout: write all remaining prespecified tables and event records.\n",
    "# This reads frozen outputs only. It does not train, score, or alter any model.\n",
    "\n",
    "import json\n",
    "import math\n",
    "from pathlib import Path\n",
    "\n",
    "import pandas as pd\n",
    "\n",
    "WORK = Path(\"/content/celiac_reliability_phase5\")\n",
    "\n",
    "scores = pd.read_csv(WORK / \"frozen_review_scores_predicted_normal.csv\")\n",
    "features = pd.read_csv(WORK / \"frozen_reliability_features.csv\")\n",
    "crop_results = json.loads(\n",
    "    (WORK / \"central_field_crop_sensitivity_results.json\").read_text()\n",
    ")\n",
    "\n",
    "assert len(scores) == 86\n",
    "assert scores[\"file_id\"].is_unique\n",
    "\n",
    "def select_top_k(frame, score_column, k):\n",
    "    return frame.sort_values(\n",
    "        [score_column, \"file_id\"],\n",
    "        ascending=[False, True],\n",
    "        kind=\"mergesort\",\n",
    "    ).head(k).copy()\n",
    "\n",
    "def summary(selected, total_events, population_size):\n",
    "    caught = int((selected[\"label\"] == \"Celiac\").sum())\n",
    "\n",
    "    return {\n",
    "        \"flagged\": int(len(selected)),\n",
    "        \"target_events_caught\": caught,\n",
    "        \"normal_alerts\": int((selected[\"label\"] == \"Normal\").sum()),\n",
    "        \"capture_among_target_events\": (\n",
    "            caught / total_events if total_events else None\n",
    "        ),\n",
    "        \"flagged_event_fraction\": caught / len(selected),\n",
    "        \"actual_review_percentage\": len(selected) / population_size,\n",
    "        \"target_events_left_unflagged\": total_events - caught,\n",
    "    }\n",
    "\n",
    "N = len(scores)\n",
    "F = int((scores[\"label\"] == \"Celiac\").sum())\n",
    "\n",
    "# Primary comparison plus the two prespecified rate sensitivity analyses.\n",
    "comparison_rows = []\n",
    "selected_sets = {}\n",
    "\n",
    "for rate in [0.10, 0.20, 0.30]:\n",
    "    k = math.ceil(rate * N)\n",
    "\n",
    "    confidence_selected = select_top_k(\n",
    "        scores, \"confidence_priority_percentile\", k\n",
    "    )\n",
    "    combined_selected = select_top_k(\n",
    "        scores, \"combined_review_priority\", k\n",
    "    )\n",
    "\n",
    "    confidence = summary(confidence_selected, F, N)\n",
    "    combined = summary(combined_selected, F, N)\n",
    "\n",
    "    for method_name, result in [\n",
    "        (\"Confidence-only\", confidence),\n",
    "        (\"Equal-weight combined\", combined),\n",
    "    ]:\n",
    "        comparison_rows.append({\n",
    "            \"requested_review_rate\": rate,\n",
    "            \"actual_review_percentage\": result[\"actual_review_percentage\"],\n",
    "            \"K_flagged\": result[\"flagged\"],\n",
    "            \"method\": method_name,\n",
    "            \"target_events_caught\": result[\"target_events_caught\"],\n",
    "            \"capture_among_F\": result[\"capture_among_target_events\"],\n",
    "            \"normal_alerts\": result[\"normal_alerts\"],\n",
    "            \"flagged_event_fraction\": result[\"flagged_event_fraction\"],\n",
    "            \"target_events_left_unflagged\": (\n",
    "                result[\"target_events_left_unflagged\"]\n",
    "            ),\n",
    "        })\n",
    "\n",
    "    selected_sets[rate] = {\n",
    "        \"confidence\": confidence_selected,\n",
    "        \"combined\": combined_selected,\n",
    "        \"difference\": (\n",
    "            combined[\"target_events_caught\"]\n",
    "            - confidence[\"target_events_caught\"]\n",
    "        ),\n",
    "        \"all_set_overlap\": int(\n",
    "            len(\n",
    "                set(confidence_selected[\"file_id\"])\n",
    "                & set(combined_selected[\"file_id\"])\n",
    "            )\n",
    "        ),\n",
    "    }\n",
    "\n",
    "comparison_table = pd.DataFrame(comparison_rows)\n",
    "comparison_table.to_csv(\n",
    "    WORK / \"phase5_review_ranking_comparison_table.csv\",\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "# Prespecified 20% equal-rank ablations.\n",
    "K_20 = math.ceil(0.20 * N)\n",
    "\n",
    "scores[\"confidence_plus_instability\"] = scores[\n",
    "    [\n",
    "        \"confidence_priority_percentile\",\n",
    "        \"instability_percentile\",\n",
    "    ]\n",
    "].mean(axis=1)\n",
    "\n",
    "scores[\"confidence_plus_quality\"] = scores[\n",
    "    [\n",
    "        \"confidence_priority_percentile\",\n",
    "        \"technical_quality_percentile\",\n",
    "    ]\n",
    "].mean(axis=1)\n",
    "\n",
    "ablation_rows = []\n",
    "\n",
    "for method_name, score_column in [\n",
    "    (\"Confidence-only\", \"confidence_priority_percentile\"),\n",
    "    (\"Confidence + instability\", \"confidence_plus_instability\"),\n",
    "    (\"Confidence + technical quality\", \"confidence_plus_quality\"),\n",
    "    (\"Equal-weight combined\", \"combined_review_priority\"),\n",
    "]:\n",
    "    selected = select_top_k(scores, score_column, K_20)\n",
    "    result = summary(selected, F, N)\n",
    "\n",
    "    ablation_rows.append({\n",
    "        \"method\": method_name,\n",
    "        \"K_flagged\": result[\"flagged\"],\n",
    "        \"target_events_caught\": result[\"target_events_caught\"],\n",
    "        \"capture_among_F\": result[\"capture_among_target_events\"],\n",
    "        \"normal_alerts\": result[\"normal_alerts\"],\n",
    "        \"target_events_left_unflagged\": (\n",
    "            result[\"target_events_left_unflagged\"]\n",
    "        ),\n",
    "    })\n",
    "\n",
    "ablation_table = pd.DataFrame(ablation_rows)\n",
    "ablation_table.to_csv(\n",
    "    WORK / \"phase5_primary_20pct_ablation_table.csv\",\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "# Exact 20% set membership and target-event filenames.\n",
    "confidence_20_ids = set(\n",
    "    selected_sets[0.20][\"confidence\"][\"file_id\"]\n",
    ")\n",
    "combined_20_ids = set(\n",
    "    selected_sets[0.20][\"combined\"][\"file_id\"]\n",
    ")\n",
    "\n",
    "membership = scores[\n",
    "    [\n",
    "        \"file_id\",\n",
    "        \"label\",\n",
    "        \"p_normal\",\n",
    "        \"confidence_priority_rank\",\n",
    "        \"combined_review_priority_rank\",\n",
    "    ]\n",
    "].copy()\n",
    "\n",
    "membership[\"flagged_by_confidence_20pct\"] = (\n",
    "    membership[\"file_id\"].isin(confidence_20_ids)\n",
    ")\n",
    "\n",
    "membership[\"flagged_by_combined_20pct\"] = (\n",
    "    membership[\"file_id\"].isin(combined_20_ids)\n",
    ")\n",
    "\n",
    "membership[\"flagged_by_both_20pct\"] = (\n",
    "    membership[\"flagged_by_confidence_20pct\"]\n",
    "    & membership[\"flagged_by_combined_20pct\"]\n",
    ")\n",
    "\n",
    "membership.to_csv(\n",
    "    WORK / \"phase5_20pct_flagged_set_membership.csv\",\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "target_events = membership.loc[\n",
    "    membership[\"label\"] == \"Celiac\"\n",
    "].copy()\n",
    "\n",
    "target_events.to_csv(\n",
    "    WORK / \"phase5_all_false_normal_events.csv\",\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "# Full-image classifier metrics.\n",
    "confusion = pd.crosstab(\n",
    "    features[\"label\"],\n",
    "    features[\"predicted_label\"],\n",
    ").reindex(\n",
    "    index=[\"Normal\", \"Celiac\"],\n",
    "    columns=[\"Normal\", \"Celiac\"],\n",
    "    fill_value=0,\n",
    ")\n",
    "\n",
    "full_sensitivity = (\n",
    "    int(confusion.loc[\"Celiac\", \"Celiac\"])\n",
    "    / int(confusion.loc[\"Celiac\"].sum())\n",
    ")\n",
    "\n",
    "full_specificity = (\n",
    "    int(confusion.loc[\"Normal\", \"Normal\"])\n",
    "    / int(confusion.loc[\"Normal\"].sum())\n",
    ")\n",
    "\n",
    "expected_outputs = [\n",
    "    \"frozen_fold_assignments.csv\",\n",
    "    \"frozen_oof_predictions.csv\",\n",
    "    \"frozen_reliability_features.csv\",\n",
    "    \"frozen_review_scores_predicted_normal.csv\",\n",
    "    \"frozen_primary_comparison_results.json\",\n",
    "    \"technical_visibility_annotation_sheet_completed.csv\",\n",
    "    \"technical_visibility_feature_validation_results.csv\",\n",
    "    \"group_resampled_bootstrap_primary_summary.csv\",\n",
    "    \"central_field_crop_oof_predictions.csv\",\n",
    "    \"central_field_crop_sensitivity_results.json\",\n",
    "    \"central_field_crop_layout_error_comparison.csv\",\n",
    "    \"full_image_quality_by_label_and_layout.csv\",\n",
    "    \"phase5_review_ranking_comparison_table.csv\",\n",
    "    \"phase5_primary_20pct_ablation_table.csv\",\n",
    "    \"phase5_20pct_flagged_set_membership.csv\",\n",
    "    \"phase5_all_false_normal_events.csv\",\n",
    "]\n",
    "\n",
    "manifest = {\n",
    "    \"phase\": \"Phase 5\",\n",
    "    \"status\": \"analysis complete\",\n",
    "    \"primary_population_N_predicted_normal\": N,\n",
    "    \"primary_target_events_F_celiac_labeled\": F,\n",
    "    \"primary_K_20pct\": K_20,\n",
    "    \"primary_confidence_events_caught\": int(\n",
    "        selected_sets[0.20][\"confidence\"][\"label\"].eq(\"Celiac\").sum()\n",
    "    ),\n",
    "    \"primary_combined_events_caught\": int(\n",
    "        selected_sets[0.20][\"combined\"][\"label\"].eq(\"Celiac\").sum()\n",
    "    ),\n",
    "    \"primary_paired_difference_combined_minus_confidence\": (\n",
    "        selected_sets[0.20][\"difference\"]\n",
    "    ),\n",
    "    \"full_image_sensitivity\": full_sensitivity,\n",
    "    \"full_image_specificity\": full_specificity,\n",
    "    \"central_crop_primary_difference\": (\n",
    "        crop_results[\"comparisons\"][\"0.2\"][\n",
    "            \"paired_difference_combined_minus_confidence\"\n",
    "        ]\n",
    "    ),\n",
    "    \"required_output_files_present\": {\n",
    "        filename: (WORK / filename).exists()\n",
    "        for filename in expected_outputs\n",
    "    },\n",
    "}\n",
    "\n",
    "with open(WORK / \"phase5_completion_manifest.json\", \"w\") as file:\n",
    "    json.dump(manifest, file, indent=2)\n",
    "\n",
    "summary_text = f\"\"\"PHASE 5 RESULTS CLOSEOUT\n",
    "\n",
    "Primary full-image comparison\n",
    "- Predicted-Normal images (N): {N}\n",
    "- Celiac-labeled false-normal events (F): {F}\n",
    "- 20% review count (K): {K_20}\n",
    "- Confidence-only events caught: {manifest[\"primary_confidence_events_caught\"]}\n",
    "- Equal-weight combined events caught: {manifest[\"primary_combined_events_caught\"]}\n",
    "- Paired difference, combined minus confidence: {manifest[\"primary_paired_difference_combined_minus_confidence\"]}\n",
    "- Full-image sensitivity: {full_sensitivity:.3f}\n",
    "- Full-image specificity: {full_specificity:.3f}\n",
    "\n",
    "This file records frozen outputs only. The primary conclusion is based on\n",
    "the full-image 20% comparison; crop and quality analyses are sensitivity\n",
    "or diagnostic analyses.\n",
    "\"\"\"\n",
    "\n",
    "(WORK / \"phase5_results_closeout_summary.txt\").write_text(summary_text)\n",
    "\n",
    "print(\"Phase 5 closeout complete.\\n\")\n",
    "\n",
    "print(\"Primary/sensitivity comparison table:\")\n",
    "print(comparison_table.to_string(index=False))\n",
    "\n",
    "print(\"\\n20% ablation table:\")\n",
    "print(ablation_table.to_string(index=False))\n",
    "\n",
    "print(\"\\n20% flagged-set overlap:\",\n",
    "      selected_sets[0.20][\"all_set_overlap\"],\n",
    "      f\"of {K_20}\")\n",
    "\n",
    "print(\"\\nAll Celiac-labeled false-normal event filenames:\")\n",
    "print(\", \".join(target_events[\"file_id\"].sort_values().tolist()))\n",
    "\n",
    "print(\"\\nCompletion manifest saved:\",\n",
    "      WORK / \"phase5_completion_manifest.json\")"
  ],
