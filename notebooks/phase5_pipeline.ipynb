  "cell_type": "code",
  "source": [
    "# Inspect whether full-image quality proxies differ by supplied label or layout category.\n",
    "\n",
    "from pathlib import Path\n",
    "import pandas as pd\n",
    "\n",
    "WORK = Path(\"/content/celiac_reliability_phase5\")\n",
    "\n",
    "features = pd.read_csv(WORK / \"frozen_reliability_features.csv\")\n",
    "assignments = pd.read_csv(WORK / \"frozen_fold_assignments.csv\")\n",
    "\n",
    "data = features[\n",
    "    [\n",
    "        \"file_id\",\n",
    "        \"label\",\n",
    "        \"blur_proxy\",\n",
    "        \"extreme_exposure_fraction\",\n",
    "        \"glare_fraction\",\n",
    "    ]\n",
    "].merge(\n",
    "    assignments[[\"file_id\", \"visible_overlay_style\"]],\n",
    "    on=\"file_id\",\n",
    "    validate=\"one_to_one\",\n",
    ")\n",
    "\n",
    "data[\"visible_overlay_style\"] = (\n",
    "    data[\"visible_overlay_style\"]\n",
    "    .fillna(\"Not recorded\")\n",
    "    .astype(str)\n",
    ")\n",
    "\n",
    "quality_columns = [\n",
    "    \"blur_proxy\",\n",
    "    \"extreme_exposure_fraction\",\n",
    "    \"glare_fraction\",\n",
    "]\n",
    "\n",
    "by_label = (\n",
    "    data\n",
    "    .groupby(\"label\")[quality_columns]\n",
    "    .agg([\"count\", \"median\", \"mean\"])\n",
    ")\n",
    "\n",
    "by_label_layout = (\n",
    "    data\n",
    "    .groupby([\"label\", \"visible_overlay_style\"])[quality_columns]\n",
    "    .agg([\"count\", \"median\", \"mean\"])\n",
    ")\n",
    "\n",
    "label_layout_counts = pd.crosstab(\n",
    "    data[\"visible_overlay_style\"],\n",
    "    data[\"label\"],\n",
    "    margins=True,\n",
    ")\n",
    "\n",
    "by_label.to_csv(WORK / \"quality_proxy_summary_by_label.csv\")\n",
    "by_label_layout.to_csv(\n",
    "    WORK / \"quality_proxy_summary_by_label_and_layout.csv\"\n",
    ")\n",
    "label_layout_counts.to_csv(\n",
    "    WORK / \"label_counts_by_audited_layout_category.csv\"\n",
    ")\n",
    "\n",
    "print(\"Quality proxies by supplied image label:\")\n",
    "print(by_label.round(5).to_string())\n",
    "\n",
    "print(\"\\nImage-label counts by audited layout category:\")\n",
    "print(label_layout_counts.to_string())\n",
    "\n",
    "print(\"\\nQuality proxies by label and layout category:\")\n",
    "print(by_label_layout.round(5).to_string())\n",
    "\n",
    "print(\"\\nSaved diagnostic tables to the project folder.\")"
