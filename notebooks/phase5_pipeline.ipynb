{
  "cell_type": "code",
  "source": [
    "# FINAL PDF REBUILD — run this ONE complete cell in Google Colab\n",
    "\n",
    "import os\n",
    "from pathlib import Path\n",
    "from xml.sax.saxutils import escape\n",
    "\n",
    "import pandas as pd\n",
    "from matplotlib import font_manager\n",
    "\n",
    "from reportlab.lib import colors\n",
    "from reportlab.lib.enums import TA_CENTER, TA_LEFT\n",
    "from reportlab.lib.pagesizes import letter\n",
    "from reportlab.lib.styles import ParagraphStyle, getSampleStyleSheet\n",
    "from reportlab.lib.units import inch\n",
    "from reportlab.pdfbase import pdfmetrics\n",
    "from reportlab.pdfbase.ttfonts import TTFont\n",
    "from reportlab.platypus import (\n",
    "    SimpleDocTemplate, Paragraph, Spacer, Table, TableStyle, KeepTogether\n",
    ")\n",
    "\n",
    "# ----------------------------\n",
    "# 1. Output folder\n",
    "# ----------------------------\n",
    "OUT_DIR = Path(\"/content/celiac_reliability_phase5\")\n",
    "OUT_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "REPORT_PATH = OUT_DIR / \"Phase5_Celiac_Image_Reliability_Results_FIXED.pdf\"\n",
    "BRIEF_PATH = OUT_DIR / \"Celiac_Endoscopy_AI_Mentor_Brief_UPDATED_FIXED.pdf\"\n",
    "\n",
    "# ----------------------------\n",
    "# 2. Use a font that exists in Colab\n",
    "# ----------------------------\n",
    "regular_font_path = font_manager.findfont(\n",
    "    font_manager.FontProperties(family=\"DejaVu Sans\"),\n",
    "    fallback_to_default=True\n",
    ")\n",
    "bold_font_path = font_manager.findfont(\n",
    "    font_manager.FontProperties(family=\"DejaVu Sans\", weight=\"bold\"),\n",
    "    fallback_to_default=True\n",
    ")\n",
    "\n",
    "pdfmetrics.registerFont(TTFont(\"CleanSans\", regular_font_path))\n",
    "pdfmetrics.registerFont(TTFont(\"CleanSansBold\", bold_font_path))\n",
    "\n",
    "# ----------------------------\n",
    "# 3. PDF styles\n",
    "# Explicit LEFT alignment prevents stretched / spaced-out text.\n",
    "# ----------------------------\n",
    "styles = getSampleStyleSheet()\n",
    "\n",
    "title_style = ParagraphStyle(\n",
    "    \"TitleClean\",\n",
    "    parent=styles[\"Title\"],\n",
    "    fontName=\"CleanSansBold\",\n",
    "    fontSize=17,\n",
    "    leading=21,\n",
    "    alignment=TA_CENTER,\n",
    "    textColor=colors.HexColor(\"#17365D\"),\n",
    "    spaceAfter=10,\n",
    ")\n",
    "\n",
    "subtitle_style = ParagraphStyle(\n",
    "    \"SubtitleClean\",\n",
    "    parent=styles[\"Normal\"],\n",
    "    fontName=\"CleanSans\",\n",
    "    fontSize=9,\n",
    "    leading=12,\n",
    "    alignment=TA_CENTER,\n",
    "    textColor=colors.HexColor(\"#555555\"),\n",
    "    spaceAfter=12,\n",
    ")\n",
    "\n",
    "heading_style = ParagraphStyle(\n",
    "    \"HeadingClean\",\n",
    "    parent=styles[\"Heading2\"],\n",
    "    fontName=\"CleanSansBold\",\n",
    "    fontSize=11,\n",
    "    leading=14,\n",
    "    alignment=TA_LEFT,\n",
    "    textColor=colors.HexColor(\"#17365D\"),\n",
    "    spaceBefore=7,\n",
    "    spaceAfter=4,\n",
    ")\n",
    "\n",
    "body_style = ParagraphStyle(\n",
    "    \"BodyClean\",\n",
    "    parent=styles[\"BodyText\"],\n",
    "    fontName=\"CleanSans\",\n",
    "    fontSize=9.2,\n",
    "    leading=12.2,\n",
    "    alignment=TA_LEFT,\n",
    "    spaceAfter=5,\n",
    ")\n",
    "\n",
    "small_style = ParagraphStyle(\n",
    "    \"SmallClean\",\n",
    "    parent=body_style,\n",
    "    fontSize=8.2,\n",
    "    leading=10.3,\n",
    "    textColor=colors.HexColor(\"#333333\"),\n",
    ")\n",
    "\n",
    "table_text_style = ParagraphStyle(\n",
    "    \"TableTextClean\",\n",
    "    parent=body_style,\n",
    "    fontSize=7.4,\n",
    "    leading=9.0,\n",
    "    alignment=TA_LEFT,\n",
    "    spaceAfter=0,\n",
    ")\n",
    "\n",
    "table_header_style = ParagraphStyle(\n",
    "    \"TableHeaderClean\",\n",
    "    parent=table_text_style,\n",
    "    fontName=\"CleanSansBold\",\n",
    "    textColor=colors.white,\n",
    ")\n",
    "\n",
    "note_style = ParagraphStyle(\n",
    "    \"NoteClean\",\n",
    "    parent=small_style,\n",
    "    backColor=colors.HexColor(\"#F1F5F9\"),\n",
    "    borderColor=colors.HexColor(\"#CBD5E1\"),\n",
    "    borderWidth=0.5,\n",
    "    borderPadding=6,\n",
    "    spaceBefore=5,\n",
    "    spaceAfter=7,\n",
    ")\n",
    "\n",
    "def P(text, style=body_style):\n",
    "    return Paragraph(escape(str(text)).replace(\"\\n\", \"<br/>\"), style)\n",
    "\n",
    "def table_cell(text, header=False):\n",
    "    return Paragraph(\n",
    "        escape(str(text)).replace(\"\\n\", \"<br/>\"),\n",
    "        table_header_style if header else table_text_style\n",
    "    )\n",
    "\n",
    "def make_table(headers, rows, widths):\n",
    "    data = [[table_cell(h, header=True) for h in headers]]\n",
    "    for row in rows:\n",
    "        data.append([table_cell(x) for x in row])\n",
    "\n",
    "    tbl = Table(data, colWidths=widths, repeatRows=1, hAlign=\"LEFT\")\n",
    "    tbl.setStyle(TableStyle([\n",
    "        (\"BACKGROUND\", (0, 0), (-1, 0), colors.HexColor(\"#17365D\")),\n",
    "        (\"TEXTCOLOR\", (0, 0), (-1, 0), colors.white),\n",
    "        (\"FONTNAME\", (0, 0), (-1, 0), \"CleanSansBold\"),\n",
    "        (\"FONTNAME\", (0, 1), (-1, -1), \"CleanSans\"),\n",
    "        (\"GRID\", (0, 0), (-1, -1), 0.35, colors.HexColor(\"#CBD5E1\")),\n",
    "        (\"BACKGROUND\", (0, 1), (-1, -1), colors.white),\n",
    "        (\"VALIGN\", (0, 0), (-1, -1), \"TOP\"),\n",
    "        (\"LEFTPADDING\", (0, 0), (-1, -1), 4),\n",
    "        (\"RIGHTPADDING\", (0, 0), (-1, -1), 4),\n",
    "        (\"TOPPADDING\", (0, 0), (-1, -1), 4),\n",
    "        (\"BOTTOMPADDING\", (0, 0), (-1, -1), 4),\n",
    "    ]))\n",
    "    return tbl\n",
    "\n",
    "def footer(canvas, doc):\n",
    "    canvas.saveState()\n",
    "    canvas.setFont(\"CleanSans\", 7.3)\n",
    "    canvas.setFillColor(colors.HexColor(\"#666666\"))\n",
    "    canvas.drawString(\n",
    "        0.55 * inch,\n",
    "        0.38 * inch,\n",
    "        \"Exploratory image-level reliability analysis — not for clinical diagnosis or patient-level inference.\"\n",
    "    )\n",
    "    canvas.drawRightString(\n",
    "        7.95 * inch,\n",
    "        0.38 * inch,\n",
    "        f\"Page {doc.page}\"\n",
    "    )\n",
    "    canvas.restoreState()\n",
    "\n",
    "# ----------------------------\n",
    "# 4. Main Phase 5 report\n",
    "# ----------------------------\n",
    "report_story = []\n",
    "\n",
    "report_story.append(P(\"Phase 5: Celiac Endoscopy Image Reliability Results\", title_style))\n",
    "report_story.append(P(\n",
    "    \"Blinded, image-level exploratory reliability analysis | 159 canonical images | 84 supplied Normal and 75 supplied Celiac\",\n",
    "    subtitle_style\n",
    "))\n",
    "\n",
    "report_story.append(P(\"Question and scope\", heading_style))\n",
    "report_story.append(P(\n",
    "    \"This analysis tested whether a simple technical-quality-informed review ranking improved identification of \"\n",
    "    \"Celiac-labeled images among images predicted as Normal by a held-out image classifier. \"\n",
    "    \"The work is exploratory and image-level only; it does not establish diagnostic performance, causality, \"\n",
    "    \"or patient-level clinical utility.\"\n",
    "))\n",
    "\n",
    "report_story.append(P(\"Locked analysis setup\", heading_style))\n",
    "report_story.append(P(\n",
    "    \"Five fixed group-disjoint folds were used. A ResNet-18 model was fine-tuned using layer4 and the classification head. \"\n",
    "    \"Held-out predictions were pooled across folds. The primary comparison reviewed the lowest-confidence predicted-Normal \"\n",
    "    \"images versus an equal-weight combined ranking using low confidence, transformation instability, and technical proxies.\"\n",
    "))\n",
    "\n",
    "report_story.append(P(\"Primary review result: full images\", heading_style))\n",
    "primary_rows = [\n",
    "    [\"10%\", \"9\", \"4 / 14\", \"2 / 14\", \"−2\"],\n",
    "    [\"20% (primary)\", \"18\", \"6 / 14\", \"4 / 14\", \"−2\"],\n",
    "    [\"30%\", \"26\", \"8 / 14\", \"8 / 14\", \"0\"],\n",
    "]\n",
    "report_story.append(make_table(\n",
    "    [\"Review rate\", \"K\", \"Confidence-only events caught\", \"Combined-score events caught\", \"Combined − confidence\"],\n",
    "    primary_rows,\n",
    "    [0.9*inch, 0.45*inch, 1.85*inch, 1.85*inch, 1.15*inch]\n",
    "))\n",
    "report_story.append(P(\n",
    "    \"At the prespecified 20% review rate, the combined score caught 4 of 14 Celiac-labeled false-Normal images, \"\n",
    "    \"while confidence-only ranking caught 6 of 14. The observed paired difference was −2 events.\"\n",
    "))\n",
    "\n",
    "report_story.append(P(\"Model error summary\", heading_style))\n",
    "confusion_rows = [\n",
    "    [\"Supplied Normal\", \"72\", \"12\"],\n",
    "    [\"Supplied Celiac\", \"14\", \"61\"],\n",
    "]\n",
    "report_story.append(make_table(\n",
    "    [\"Image label\", \"Predicted Normal\", \"Predicted Celiac\"],\n",
    "    confusion_rows,\n",
    "    [2.0*inch, 1.55*inch, 1.55*inch]\n",
    "))\n",
    "report_story.append(P(\n",
    "    \"Image-level sensitivity for supplied Celiac images was 61/75 = 0.813. \"\n",
    "    \"Image-level specificity for supplied Normal images was 72/84 = 0.857.\"\n",
    "))\n",
    "\n",
    "report_story.append(P(\"20% review-rate ablation\", heading_style))\n",
    "ablation_rows = [\n",
    "    [\"Confidence only\", \"6 / 14\", \"0.429\", \"12\", \"8\"],\n",
    "    [\"Confidence + instability\", \"4 / 14\", \"0.286\", \"14\", \"10\"],\n",
    "    [\"Confidence + technical quality\", \"5 / 14\", \"0.357\", \"13\", \"9\"],\n",
    "    [\"Equal-weight combined\", \"4 / 14\", \"0.286\", \"14\", \"10\"],\n",
    "]\n",
    "report_story.append(make_table(\n",
    "    [\"Method\", \"Events caught\", \"Capture\", \"Normal alerts\", \"Events left unflagged\"],\n",
    "    ablation_rows,\n",
    "    [1.8*inch, 1.05*inch, 0.75*inch, 1.0*inch, 1.4*inch]\n",
    "))\n",
    "\n",
    "report_story.append(P(\n",
    "    \"Bootstrap uncertainty for the primary difference was wide: 95% percentile interval [−5, 1]. \"\n",
    "    \"Across resamples, confidence-only ranking was better 75.0% of the time, equal 18.5%, and combined ranking better 6.6%.\"\n",
    "))\n",
    "\n",
    "report_story.append(P(\"Central-field crop sensitivity analysis\", heading_style))\n",
    "crop_rows = [\n",
    "    [\"10%\", \"9\", \"2\", \"3\", \"+1\"],\n",
    "    [\"20%\", \"17\", \"4\", \"4\", \"0\"],\n",
    "    [\"30%\", \"26\", \"6\", \"7\", \"+1\"],\n",
    "]\n",
    "report_story.append(make_table(\n",
    "    [\"Review rate\", \"K\", \"Confidence events caught\", \"Combined events caught\", \"Difference\"],\n",
    "    crop_rows,\n",
    "    [0.95*inch, 0.5*inch, 1.6*inch, 1.5*inch, 1.0*inch]\n",
    "))\n",
    "report_story.append(P(\n",
    "    \"The crop retained the central 80% of image width and 70% of image height. \"\n",
    "    \"Crop-model sensitivity was 0.853 and specificity was 0.881. At 20%, both rankings caught 4 target events. \"\n",
    "    \"This is a shortcut-sensitivity check only; the full-image analysis remains primary.\"\n",
    "))\n",
    "\n",
    "report_story.append(P(\"Technical visibility and acquisition-layout checks\", heading_style))\n",
    "report_story.append(P(\n",
    "    \"An exploratory AI-assisted, non-expert blinded technical-visibility annotation was compared with automated proxies. \"\n",
    "    \"Only exposure showed a positive association with the visibility score (Spearman ρ = 0.465, p = 0.010). \"\n",
    "    \"Blur (ρ = −0.197), glare (ρ = 0.021), and the overall quality composite (ρ = 0.277; expected direction negative) \"\n",
    "    \"did not provide clear validation. Therefore, the overall automated quality composite should not be treated as validated.\"\n",
    "))\n",
    "report_story.append(P(\n",
    "    \"Acquisition-layout categories were imbalanced by supplied image label: SD date/time-camera-status images were more common \"\n",
    "    \"in Normal images (50 Normal, 23 Celiac), while the HD lower white annotation-strip layout was more common in Celiac images \"\n",
    "    \"(36 Celiac, 20 Normal). These are potential dataset/acquisition proxies rather than clinical features.\"\n",
    "))\n",
    "\n",
    "report_story.append(P(\n",
    "    \"Interpretation: the planned technical-quality-informed combined ranking did not improve primary full-image capture over \"\n",
    "    \"confidence-only ranking. Any apparent crop differences are sensitivity results and do not change the primary conclusion.\",\n",
    "    note_style\n",
    "))\n",
    "\n",
    "report_story.append(P(\"Appendix: supplied Celiac images predicted as Normal (n = 14)\", heading_style))\n",
    "false_normals = (\n",
    "    \"b14.jpg, b16.jpg, b17.jpg, b2.JPG, b21.jpg, b25.jpg, b26.jpg, b4.JPG, \"\n",
    "    \"b5.JPG, b6.JPG, c22.JPG, c33.jpg, c34.jpg, hk4.jpg\"\n",
    ")\n",
    "report_story.append(P(false_normals, small_style))\n",
    "report_story.append(P(\n",
    "    \"Output inventory: held-out predictions, ranking tables, bootstrap summary, crop sensitivity outputs, \"\n",
    "    \"technical visibility tables, diagnostic tables, and Phase 5 completion manifest were saved in \"\n",
    "    \"/content/celiac_reliability_phase5/.\",\n",
    "    small_style\n",
    "))\n",
    "\n",
    "report_doc = SimpleDocTemplate(\n",
    "    str(REPORT_PATH),\n",
    "    pagesize=letter,\n",
    "    leftMargin=0.55*inch,\n",
    "    rightMargin=0.55*inch,\n",
    "    topMargin=0.5*inch,\n",
    "    bottomMargin=0.58*inch,\n",
    ")\n",
    "\n",
    "report_doc.build(report_story, onFirstPage=footer, onLaterPages=footer)\n",
    "\n",
    "# ----------------------------\n",
    "# 5. One-page mentor brief\n",
    "# ----------------------------\n",
    "brief_story = []\n",
    "\n",
    "brief_story.append(P(\"Mentor Brief: Phase 5 Image Reliability Analysis\", title_style))\n",
    "brief_story.append(P(\n",
    "    \"Celiac endoscopy image dataset | concise project update\",\n",
    "    subtitle_style\n",
    "))\n",
    "\n",
    "brief_story.append(P(\"What was completed\", heading_style))\n",
    "brief_story.append(P(\n",
    "    \"Phase 5 was completed on 159 canonical images: 84 supplied Normal and 75 supplied Celiac. \"\n",
    "    \"Five fixed group-disjoint folds produced pooled held-out predictions from a ResNet-18 classifier.\"\n",
    "))\n",
    "\n",
    "brief_story.append(P(\"Primary finding\", heading_style))\n",
    "brief_story.append(P(\n",
    "    \"Among 86 images predicted as Normal, 14 were supplied Celiac images. At the prespecified 20% review capacity \"\n",
    "    \"(18 images), confidence-only review captured 6 of these 14 false-Normal images, while the equal-weight technical \"\n",
    "    \"combined score captured 4. The primary paired difference was −2 in favor of confidence-only ranking.\"\n",
    "))\n",
    "\n",
    "brief_story.append(P(\"Uncertainty and sensitivity checks\", heading_style))\n",
    "brief_story.append(P(\n",
    "    \"The bootstrap 95% interval for the primary difference was [−5, 1], indicating substantial uncertainty. \"\n",
    "    \"A central-field crop analysis produced a tie at 20% review (4 versus 4 target events caught), with small differences \"\n",
    "    \"at the 10% and 30% sensitivity rates. The crop analysis does not replace the full-image primary result.\"\n",
    "))\n",
    "\n",
    "brief_story.append(P(\"Quality-proxy caution\", heading_style))\n",
    "brief_story.append(P(\n",
    "    \"A blinded AI-assisted, non-expert technical-visibility check did not validate the overall automated technical-quality \"\n",
    "    \"composite. Exposure aligned with visibility, but blur, glare, and the composite did not show clear expected relationships. \"\n",
    "    \"In addition, acquisition-layout categories differed by supplied image label, so quality and layout can act as dataset proxies.\"\n",
    "))\n",
    "\n",
    "brief_story.append(P(\"Bottom line\", heading_style))\n",
    "brief_story.append(P(\n",
    "    \"The dataset supports an exploratory image-level reliability study, but not a claim that technical-quality-informed \"\n",
    "    \"review ranking improves error capture. The prespecified primary result favored confidence-only ranking. \"\n",
    "    \"Results should be presented as a feasibility and reliability analysis, not as evidence for clinical deployment.\",\n",
    "    note_style\n",
    "))\n",
    "\n",
    "brief_story.append(P(\"Recommended next step\", heading_style))\n",
    "brief_story.append(P(\n",
    "    \"Use an external, independently collected dataset with standardized acquisition and patient-level separation. \"\n",
    "    \"Have technical visibility scored by qualified human raters before using any quality composite as a decision variable.\"\n",
    "))\n",
    "\n",
    "brief_doc = SimpleDocTemplate(\n",
    "    str(BRIEF_PATH),\n",
    "    pagesize=letter,\n",
    "    leftMargin=0.65*inch,\n",
    "    rightMargin=0.65*inch,\n",
    "    topMargin=0.58*inch,\n",
    "    bottomMargin=0.6*inch,\n",
    ")\n",
    "\n",
    "brief_doc.build(brief_story, onFirstPage=footer, onLaterPages=footer)\n",
    "\n",
    "# ----------------------------\n",
    "# 6. Confirm files were created\n",
    "# ----------------------------\n",
    "print(\"Done. Fixed PDFs created:\")\n",
    "print(REPORT_PATH)\n",
    "print(f\"  Size: {REPORT_PATH.stat().st_size:,} bytes\")\n",
    "print(BRIEF_PATH)\n",
    "print(f\"  Size: {BRIEF_PATH.stat().st_size:,} bytes\")\n",
    "\n",
    "# Download both files to your computer\n",
    "from google.colab import files\n",
    "files.download(str(REPORT_PATH))\n",
    "files.download(str(BRIEF_PATH))"
