  "cell_type": "code",
  "source": [
    "# Train five held-out ResNet-18 models and save pooled predictions\n",
    "\n",
    "import json\n",
    "import random\n",
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "from PIL import Image\n",
    "from torch.utils.data import DataLoader, Dataset\n",
    "from torchvision import models, transforms\n",
    "\n",
    "\n",
    "WORK = Path(\"/content/celiac_reliability_phase5\")\n",
    "MODEL_DIR = WORK / \"models\"\n",
    "MODEL_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "SEED = 20260920\n",
    "random.seed(SEED)\n",
    "np.random.seed(SEED)\n",
    "torch.manual_seed(SEED)\n",
    "\n",
    "device = torch.device(\n",
    "    \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
    ")\n",
    "\n",
    "data = pd.read_csv(\n",
    "    WORK / \"frozen_fold_assignments.csv\"\n",
    ")\n",
    "\n",
    "assert len(data) == 159\n",
    "assert data[\"working_path\"].map(\n",
    "    lambda path: Path(path).exists()\n",
    ").all()\n",
    "\n",
    "label_to_number = {\n",
    "    \"Normal\": 0,\n",
    "    \"Celiac\": 1,\n",
    "}\n",
    "\n",
    "data[\"target\"] = data[\"label\"].map(label_to_number)\n",
    "\n",
    "preprocess = transforms.Compose(\n",
    "    [\n",
    "        transforms.Resize((224, 224)),\n",
    "        transforms.ToTensor(),\n",
    "        transforms.Normalize(\n",
    "            mean=[0.485, 0.456, 0.406],\n",
    "            std=[0.229, 0.224, 0.225],\n",
    "        ),\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "class ImageDataset(Dataset):\n",
    "\n",
    "    def __init__(self, frame):\n",
    "        self.frame = frame.reset_index(drop=True)\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.frame)\n",
    "\n",
    "    def __getitem__(self, index):\n",
    "        row = self.frame.iloc[index]\n",
    "\n",
    "        image = Image.open(\n",
    "            row[\"working_path\"]\n",
    "        ).convert(\"RGB\")\n",
    "\n",
    "        image = preprocess(image)\n",
    "\n",
    "        target = torch.tensor(\n",
    "            int(row[\"target\"]),\n",
    "            dtype=torch.long,\n",
    "        )\n",
    "\n",
    "        return image, target\n",
    "\n",
    "\n",
    "def build_model():\n",
    "    model = models.resnet18(weights=None)\n",
    "\n",
    "    for parameter in model.parameters():\n",
    "        parameter.requires_grad = False\n",
    "\n",
    "    for parameter in model.layer4.parameters():\n",
    "        parameter.requires_grad = True\n",
    "\n",
    "    model.fc = nn.Linear(\n",
    "        model.fc.in_features,\n",
    "        2,\n",
    "    )\n",
    "\n",
    "    return model.to(device)\n",
    "\n",
    "\n",
    "all_predictions = []\n",
    "training_records = []\n",
    "\n",
    "for outer_fold in range(1, 6):\n",
    "\n",
    "    print(f\"Training outer fold {outer_fold}/5...\")\n",
    "\n",
    "    train_frame = data[\n",
    "        data[\"outer_fold\"] != outer_fold\n",
    "    ].copy()\n",
    "\n",
    "    test_frame = data[\n",
    "        data[\"outer_fold\"] == outer_fold\n",
    "    ].copy()\n",
    "\n",
    "    train_dataset = ImageDataset(train_frame)\n",
    "    test_dataset = ImageDataset(test_frame)\n",
    "\n",
    "    train_loader = DataLoader(\n",
    "        train_dataset,\n",
    "        batch_size=16,\n",
    "        shuffle=True,\n",
    "        num_workers=0,\n",
    "    )\n",
    "\n",
    "    test_loader = DataLoader(\n",
    "        test_dataset,\n",
    "        batch_size=16,\n",
    "        shuffle=False,\n",
    "        num_workers=0,\n",
    "    )\n",
    "\n",
    "    model = build_model()\n",
    "\n",
    "    optimizer = torch.optim.Adam(\n",
    "        [\n",
    "            parameter\n",
    "            for parameter in model.parameters()\n",
    "            if parameter.requires_grad\n",
    "        ],\n",
    "        lr=0.001,\n",
    "    )\n",
    "\n",
    "    loss_function = nn.CrossEntropyLoss()\n",
    "\n",
    "    model.train()\n",
    "\n",
    "    for epoch in range(8):\n",
    "\n",
    "        total_loss = 0.0\n",
    "\n",
    "        for images, targets in train_loader:\n",
    "\n",
    "            images = images.to(device)\n",
    "            targets = targets.to(device)\n",
    "\n",
    "            optimizer.zero_grad()\n",
    "\n",
    "            logits = model(images)\n",
    "            loss = loss_function(logits, targets)\n",
    "\n",
    "            loss.backward()\n",
    "            optimizer.step()\n",
    "\n",
    "            total_loss += loss.item()\n",
    "\n",
    "        print(\n",
    "            f\"  Epoch {epoch + 1}/8 \"\n",
    "            f\"loss={total_loss / len(train_loader):.4f}\"\n",
    "        )\n",
    "\n",
    "    checkpoint_path = (\n",
    "        MODEL_DIR\n",
    "        / f\"resnet18_outer_fold_{outer_fold}.pt\"\n",
    "    )\n",
    "\n",
    "    torch.save(\n",
    "        {\n",
    "            \"model_state_dict\": model.state_dict(),\n",
    "            \"outer_fold\": outer_fold,\n",
    "        },\n",
    "        checkpoint_path,\n",
    "    )\n",
    "\n",
    "    model.eval()\n",
    "\n",
    "    fold_predictions = []\n",
    "\n",
    "    with torch.no_grad():\n",
    "\n",
    "        for images, targets in test_loader:\n",
    "\n",
    "            images = images.to(device)\n",
    "\n",
    "            logits = model(images)\n",
    "            probabilities = torch.softmax(\n",
    "                logits,\n",
    "                dim=1,\n",
    "            )\n",
    "\n",
    "            p_normal = probabilities[:, 0].cpu().numpy()\n",
    "            p_celiac = probabilities[:, 1].cpu().numpy()\n",
    "\n",
    "            fold_predictions.extend(\n",
    "                zip(\n",
    "                    p_normal,\n",
    "                    p_celiac,\n",
    "                )\n",
    "            )\n",
    "\n",
    "    fold_output = test_frame[\n",
    "        [\"file_id\", \"label\", \"group_id\", \"outer_fold\"]\n",
    "    ].copy()\n",
    "\n",
    "    fold_output[\"p_normal\"] = [\n",
    "        values[0]\n",
    "        for values in fold_predictions\n",
    "    ]\n",
    "\n",
    "    fold_output[\"p_celiac\"] = [\n",
    "        values[1]\n",
    "        for values in fold_predictions\n",
    "    ]\n",
    "\n",
    "    fold_output[\"predicted_label\"] = np.where(\n",
    "        fold_output[\"p_normal\"] >= 0.5,\n",
    "        \"Normal\",\n",
    "        \"Celiac\",\n",
    "    )\n",
    "\n",
    "    all_predictions.append(fold_output)\n",
    "\n",
    "    training_records.append(\n",
    "        {\n",
    "            \"outer_fold\": outer_fold,\n",
    "            \"train_images\": len(train_frame),\n",
    "            \"heldout_images\": len(test_frame),\n",
    "            \"model_path\": str(checkpoint_path),\n",
    "        }\n",
    "    )\n",
    "\n",
    "    del model\n",
    "    torch.cuda.empty_cache()\n",
    "\n",
    "oof_predictions = (\n",
    "    pd.concat(\n",
    "        all_predictions,\n",
    "        ignore_index=True,\n",
    "    )\n",
    "    .sort_values(\"file_id\")\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "assert len(oof_predictions) == 159\n",
    "assert oof_predictions[\"file_id\"].is_unique\n",
    "assert oof_predictions[\"p_normal\"].between(0, 1).all()\n",
    "assert oof_predictions[\"p_celiac\"].between(0, 1).all()\n",
    "\n",
    "oof_predictions.to_csv(\n",
    "    WORK / \"frozen_oof_predictions.csv\",\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "with open(\n",
    "    WORK / \"training_records.json\",\n",
    "    \"w\",\n",
    ") as file:\n",
    "    json.dump(training_records, file, indent=2)\n",
    "\n",
    "print()\n",
    "print(\"Training complete.\")\n",
    "print(\n",
    "    f\"Saved: {WORK / 'frozen_oof_predictions.csv'}\"\n",
    ")\n",
    "print(\n",
    "    f\"Saved models in: {MODEL_DIR}\"\n",
    ")"
  ],
