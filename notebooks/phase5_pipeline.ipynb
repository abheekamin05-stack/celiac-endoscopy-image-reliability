    "import hashlib\n",
    "import shutil\n",
    "import subprocess\n",
    "from pathlib import Path\n",
    "\n",
    "import pandas as pd\n",
    "from PIL import Image\n",
    "\n",
    "\n",
    "EXPECTED_ZIP_SHA256 = (\n",
    "    \"60f3ab4a42b2481cbf809f793614edcac0385a63994225f23105f79fd3940a60\"\n",
    ")\n",
    "\n",
    "WORK = Path(\"/content/celiac_reliability_phase5\")\n",
    "\n",
    "# Find the uploaded ZIP in either /content or /\n",
    "search_roots = [\n",
    "    Path(\"/content\"),\n",
    "    Path(\"/\"),\n",
    "]\n",
    "\n",
    "zip_candidates = []\n",
    "\n",
    "for folder in search_roots:\n",
    "    zip_candidates.extend(\n",
    "        folder.glob(\"*Endoscopic*Dataset*.zip\")\n",
    "    )\n",
    "\n",
    "zip_candidates = list(dict.fromkeys(zip_candidates))\n",
    "\n",
    "assert len(zip_candidates) == 1, (\n",
    "    \"Upload the dataset ZIP through the Colab Files panel. \"\n",
    "    f\"Found: {zip_candidates}\"\n",
    ")\n",
    "\n",
    "SOURCE_ZIP = zip_candidates[0]\n",
    "\n",
    "# Verify the dataset\n",
    "zip_sha256 = hashlib.sha256(\n",
    "    SOURCE_ZIP.read_bytes()\n",
    ").hexdigest()\n",
    "\n",
    "assert zip_sha256 == EXPECTED_ZIP_SHA256, (\n",
    "    f\"Checksum mismatch.\\n\"\n",
    "    f\"Expected: {EXPECTED_ZIP_SHA256}\\n\"\n",
    "    f\"Found: {zip_sha256}\"\n",
    ")\n",
    "\n",
    "# Install the extractor\n",
    "subprocess.run(\n",
    "    [\n",
    "        \"bash\",\n",
    "        \"-lc\",\n",
    "        \"apt-get -qq update && \"\n",
    "        \"apt-get -qq install -y -qq p7zip-full\",\n",
    "    ],\n",
    "    check=True,\n",
    ")\n",
    "\n",
    "# Rebuild the working directory\n",
    "if WORK.exists():\n",
    "    shutil.rmtree(WORK)\n",
    "\n",
    "outer_dir = WORK / \"outer_zip\"\n",
    "raw_dir = WORK / \"raw_7z\"\n",
    "canonical_dir = WORK / \"canonical_images\"\n",
    "\n",
    "WORK.mkdir(parents=True)\n",
    "\n",
    "# Extract the ZIP and nested 7z archive\n",
    "shutil.unpack_archive(\n",
    "    SOURCE_ZIP,\n",
    "    outer_dir,\n",
    ")\n",
    "\n",
    "nested_7z = next(\n",
    "    outer_dir.rglob(\"*.7z\")\n",
    ")\n",
    "\n",
    "subprocess.run(\n",
    "    [\n",
    "        \"7z\",\n",
    "        \"x\",\n",
    "        \"-y\",\n",
    "        f\"-o{raw_dir}\",\n",
    "        str(nested_7z),\n",
    "    ],\n",
    "    check=True,\n",
    ")\n",
    "\n",
    "# Build a manifest from the extracted images\n",
    "rows = []\n",
    "\n",
    "label_dirs = {\n",
    "    \"celiac\": \"Celiac\",\n",
    "    \"normal\": \"Normal\",\n",
    "    \"doubtful\": \"Doubtful\",\n",
    "}\n",
    "\n",
    "for image_path in sorted(raw_dir.rglob(\"*\")):\n",
    "\n",
    "    if not image_path.is_file():\n",
    "        continue\n",
    "\n",
    "    if image_path.suffix.lower() not in {\n",
    "        \".jpg\",\n",
    "        \".jpeg\",\n",
    "    }:\n",
    "        continue\n",
    "\n",
    "    relative_path = image_path.relative_to(\n",
    "        raw_dir\n",
    "    ).as_posix()\n",
    "\n",
    "    folder_name = Path(\n",
    "        relative_path\n",
    "    ).parts[-2].lower()\n",
    "\n",
    "    if folder_name not in label_dirs:\n",
    "        continue\n",
    "\n",
    "    label = label_dirs[folder_name]\n",
    "\n",
    "    with Image.open(image_path) as image:\n",
    "        width, height = image.size\n",
    "\n",
    "    rows.append(\n",
    "        {\n",
    "            \"file_id\": f\"{label}/{image_path.name}\",\n",
    "            \"path_in_archive\": relative_path,\n",
    "            \"filename\": image_path.name,\n",
    "            \"label\": label,\n",
    "            \"width\": width,\n",
    "            \"height\": height,\n",
    "            \"sha256\": hashlib.sha256(\n",
    "                image_path.read_bytes()\n",
    "            ).hexdigest(),\n",
    "            \"visible_overlay_style\": \"unknown\",\n",
    "        }\n",
    "    )\n",
    "\n",
    "manifest = pd.DataFrame(rows)\n",
    "\n",
    "# Keep only Normal and Celiac images\n",
    "binary = manifest[\n",
    "    manifest[\"label\"].isin(\n",
    "        [\"Normal\", \"Celiac\"]\n",
    "    )\n",
    "].copy()\n",
    "\n",
    "# Remove exact duplicate Normal copies\n",
    "excluded_duplicate_copies = {\n",
    "    \"Normal/n64.jpg\",\n",
    "    \"Normal/n61.jpg\",\n",
    "    \"Normal/n67.jpg\",\n",
    "    \"Normal/n68.jpg\",\n",
    "    \"Normal/n66.jpg\",\n",
    "}\n",
    "\n",
    "canonical = binary[\n",
    "    ~binary[\"file_id\"].isin(\n",
    "        excluded_duplicate_copies\n",
    "    )\n",
    "].sort_values(\n",
    "    \"file_id\"\n",
    ").reset_index(\n",
    "    drop=True\n",
    ")\n",
    "\n",
    "# Verify the expected audited dataset\n",
    "assert len(binary) == 164, (\n",
    "    f\"Expected 164 binary images, found {len(binary)}\"\n",
    ")\n",
    "\n",
    "assert len(canonical) == 159, (\n",
    "    f\"Expected 159 canonical images, found {len(canonical)}\"\n",
    ")\n",
    "\n",
    "assert (\n",
    "    canonical[\"label\"] == \"Normal\"\n",
    ").sum() == 84\n",
    "\n",
    "assert (\n",
    "    canonical[\"label\"] == \"Celiac\"\n",
    ").sum() == 75\n",
    "\n",
    "# Copy the canonical images into the working directory\n",
    "for _, row in canonical.iterrows():\n",
    "\n",
    "    source = raw_dir / row[\"path_in_archive\"]\n",
    "\n",
    "    destination = canonical_dir / row[\"file_id\"]\n",
    "\n",
    "    destination.parent.mkdir(\n",
    "        parents=True,\n",
    "        exist_ok=True,\n",
    "    )\n",
    "\n",
    "    assert source.exists(), (\n",
    "        f\"Missing image: {source}\"\n",
    "    )\n",
    "\n",
    "    shutil.copy2(\n",
    "        source,\n",
    "        destination,\n",
    "    )\n",
    "\n",
    "# Save working paths\n",
    "canonical[\"working_path\"] = canonical[\n",
    "    \"file_id\"\n",
    "].map(\n",
    "    lambda file_id: str(\n",
    "        canonical_dir / file_id\n",
    "    )\n",
    ")\n",
    "\n",
    "canonical.to_csv(\n",
    "    WORK / \"canonical_manifest.csv\",\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "print(\"Setup complete.\")\n",
    "print(f\"Verified ZIP SHA-256: {zip_sha256}\")\n",
    "print(\n",
    "    f\"Canonical working set: {len(canonical)} images\"\n",
    ")\n",
    "print(\n",
    "    canonical[\"label\"].value_counts().to_string()\n",
    ")\n",
    "print(f\"Working folder: {WORK}\")"
  ]
}
