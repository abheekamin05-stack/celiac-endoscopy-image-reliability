    "from pathlib import Path\n",
    "print('CONTENT:', sorted(str(p) for p in Path('/content').iterdir()))\n",
    "print('ROOT ZIP:', sorted(str(p) for p in Path('/').glob('*Endoscopic*Image*Dataset*.zip')))\n",
    "print('ROOT XLSX:', sorted(str(p) for p in Path('/').glob('*Celiac*Image*Audit*Manifest*.xlsx')))import hashlib, shutil, subprocess, urllib.request\n",
    "from pathlib import Path\n",
    "import pandas as pd\n",
    "from PIL import Image\n",
    "\n",
    "EXPECTED_ZIP_SHA256 = \"60f3ab4a42b2481cbf809f793614edcac0385a63994225f23105f79fd3940a60\"\n",
    "WORK = Path(\"/content/celiac_reliability_phase5\")\n",
    "SOURCE_ZIP = Path(\"/content/Celiac Dataset Duodenal Endoscopic Image Dataset.zip\")\n",
    "if not SOURCE_ZIP.exists():\n",
    "    urllib.request.urlretrieve(\n",
    "      \"https://data.mendeley.com/public-api/zip/t278gdxwzc/download/2\",\n",
    "      SOURCE_ZIP\n",
    "    )\n",
    "zip_sha256 = hashlib.sha256(SOURCE_ZIP.read_bytes()).hexdigest()\n",
    "assert zip_sha256 == EXPECTED_ZIP_SHA256, zip_sha256\n",
    "if WORK.exists(): shutil.rmtree(WORK)\n",
    "outer_dir=WORK/\"outer_zip\"; raw_dir=WORK/\"raw_7z\"; canonical_dir=WORK/\"canonical_images\"\n",
    "WORK.mkdir(parents=True)\n",
    "shutil.unpack_archive(SOURCE_ZIP, outer_dir)\n",
    "nested_7z=next(outer_dir.rglob(\"*.7z\"))\n",
    "subprocess.run([\"bash\",\"-lc\",\"apt-get -qq update && apt-get -qq install -y -qq p7zip-full\"],check=True)\n",
    "subprocess.run([\"7z\",\"x\",\"-y\",f\"-o{raw_dir}\",str(nested_7z)],check=True)\n",
    "rows=[]\n",
    "label_dirs={\"celiac\":\"Celiac\",\"normal\":\"Normal\",\"doubtful\":\"Doubtful\"}\n",
    "for p in sorted(raw_dir.rglob(\"*\")):\n",
    "    if p.is_file() and p.suffix.lower() in {\".jpg\",\".jpeg\"}:\n",
    "        rel=p.relative_to(raw_dir).as_posix()\n",
    "        parts=Path(rel).parts\n",
    "        folder=parts[-2].lower()\n",
    "        if folder not in label_dirs: continue\n",
    "        label=label_dirs[folder]\n",
    "        fid=f\"{label}/{p.name}\"\n",
    "        with Image.open(p) as im: w,h=im.size\n",
    "        rows.append({\"file_id\":fid,\"path_in_archive\":rel,\"filename\":p.name,\n",
    "                     \"label\":label,\"width\":w,\"height\":h,\n",
    "                     \"sha256\":hashlib.sha256(p.read_bytes()).hexdigest(),\n",
    "                     \"visible_overlay_style\":\"unknown\"})\n",
    "manifest=pd.DataFrame(rows)\n",
    "binary=manifest[manifest.label.isin([\"Normal\",\"Celiac\"])].copy()\n",
    "excluded_duplicate_copies={\"Normal/n64.jpg\",\"Normal/n61.jpg\",\"Normal/n67.jpg\",\"Normal/n68.jpg\",\"Normal/n66.jpg\"}\n",
    "canonical=binary[~binary.file_id.isin(excluded_duplicate_copies)].sort_values(\"file_id\").reset_index(drop=True)\n",
    "assert len(binary)==164\n",
    "assert len(canonical)==159\n",
    "assert (canonical.label==\"Normal\").sum()==84\n",
    "assert (canonical.label==\"Celiac\").sum()==75\n",
    "for _,row in canonical.iterrows():\n",
    "    source=raw_dir/row.path_in_archive\n",
    "    dest=canonical_dir/row.file_id\n",
    "    dest.parent.mkdir(parents=True,exist_ok=True)\n",
    "    shutil.copy2(source,dest)\n",
    "canonical[\"working_path\"]=canonical.file_id.map(lambda x:str(canonical_dir/x))\n",
    "canonical.to_csv(WORK/\"canonical_manifest.csv\",index=False)\n",
    "print(\"Setup complete:\", zip_sha256, len(canonical))\n",
    "# Create the five fixed, stratified, group-disjoint outer folds.\n",
    "\n",
    "import hashlib\n",
    "import json\n",
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from sklearn.model_selection import StratifiedGroupKFold\n",
    "\n",
    "WORK = Path(\"/content/celiac_reliability_phase5\")\n",
    "canonical = pd.read_csv(WORK / \"canonical_manifest.csv\")\n",
    "\n",
    "# These are the strong visually related pairs specified in the frozen protocol.\n",
    "# Path matching is case-insensitive because the source archive mixes .jpg and .JPG.\n",
    "RELATED_PAIRS = [\n",
    "    (\"Celiac/c7.JPG\",  \"Celiac/c8.JPG\"),\n",
    "    (\"Celiac/c9.JPG\",  \"Celiac/c10.JPG\"),\n",
    "    (\"Celiac/c20.JPG\", \"Celiac/c21.JPG\"),\n",
    "    (\"Celiac/c19.JPG\", \"Celiac/c6.JPG\"),\n",
    "    (\"Celiac/b3.JPG\",  \"Celiac/b7.JPG\"),\n",
    "    (\"Normal/n54.jpg\", \"Normal/n55.jpg\"),\n",
    "]\n",
    "\n",
    "# Union-find: each image begins as its own group, then related pairs merge.\n",
    "file_ids = canonical[\"file_id\"].tolist()\n",
    "parent = {file_id: file_id for file_id in file_ids}\n",
    "\n",
    "def find(x):\n",
    "    while parent[x] != x:\n",
    "        parent[x] = parent[parent[x]]\n",
    "        x = parent[x]\n",
    "    return x\n",
    "\n",
    "def union(a, b):\n",
    "    root_a, root_b = find(a), find(b)\n",
    "    if root_a != root_b:\n",
    "        parent[root_b] = root_a\n",
    "\n",
    "file_lookup = {file_id.lower(): file_id for file_id in file_ids}\n",
    "\n",
    "for raw_a, raw_b in RELATED_PAIRS:\n",
    "    a = file_lookup.get(raw_a.lower())\n",
    "    b = file_lookup.get(raw_b.lower())\n",
    "    assert a is not None and b is not None, (\n",
    "        f\"Could not find a protocol-specified related pair: {raw_a}, {raw_b}\"\n",
    "    )\n",
    "    union(a, b)\n",
    "\n",
    "# Give every final group a stable ID based on its alphabetically first member.\n",
    "group_members = {}\n",
    "for file_id in file_ids:\n",
    "    group_members.setdefault(find(file_id), []).append(file_id)\n",
    "\n",
    "root_to_group_id = {\n",
    "    root: f\"group_{min(members).lower().replace('/', '_').replace('.', '_')}\"\n",
    "    for root, members in group_members.items()\n",
    "}\n",
    "\n",
    "canonical[\"group_id\"] = canonical[\"file_id\"].map(\n",
    "    lambda file_id: root_to_group_id[find(file_id)]\n",
    ")\n",
    "\n",
    "# Five fixed outer folds, exactly as specified in the protocol.\n",
    "SEED = 20260920\n",
    "splitter = StratifiedGroupKFold(\n",
    "    n_splits=5,\n",
    "    shuffle=True,\n",
    "    random_state=SEED\n",
    ")\n",
    "\n",
    "canonical[\"outer_fold\"] = -1\n",
    "\n",
    "for fold_number, (_, held_out_idx) in enumerate(\n",
    "    splitter.split(\n",
    "        X=np.zeros(len(canonical)),\n",
    "        y=canonical[\"label\"],\n",
    "        groups=canonical[\"group_id\"]\n",
    "    ),\n",
    "    start=1\n",
    "):\n",
    "    canonical.loc[held_out_idx, \"outer_fold\"] = fold_number\n",
    "\n",
    "assert (canonical[\"outer_fold\"] > 0).all()\n",
    "\n",
    "# Verify no group is split between outer folds.\n",
    "group_fold_counts = canonical.groupby(\"group_id\")[\"outer_fold\"].nunique()\n",
    "assert group_fold_counts.max() == 1, \"A related-image group was split across folds.\"\n",
    "\n",
    "# Save these assignments. Do not edit or regenerate them after this point.\n",
    "assignment_columns = [\n",
    "    \"file_id\", \"label\", \"group_id\", \"outer_fold\",\n",
    "    \"visible_overlay_style\", \"width\", \"height\", \"sha256\", \"working_path\"\n",
    "]\n",
    "frozen_assignments = canonical[assignment_columns].sort_values(\"file_id\")\n",
    "frozen_assignments.to_csv(WORK / \"frozen_fold_assignments.csv\", index=False)\n",
    "\n",
    "manifest_sha256 = hashlib.sha256(\n",
    "    (WORK / \"canonical_manifest.csv\").read_bytes()\n",
    ").hexdigest()\n",
    "\n",
    "metadata = {\n",
    "    \"protocol_version\": \"1.0\",\n",
    "    \"protocol_date\": \"2026-09-20\",\n",
    "    \"random_seed\": SEED,\n",
    "    \"n_outer_folds\": 5,\n",
    "    \"canonical_image_count\": int(len(canonical)),\n",
    "    \"normal_count\": int((canonical[\"label\"] == \"Normal\").sum()),\n",
    "    \"celiac_count\": int((canonical[\"label\"] == \"Celiac\").sum()),\n",
    "    \"canonical_manifest_sha256\": manifest_sha256,\n",
    "    \"related_pairs_grouped\": RELATED_PAIRS,\n",
    "    \"assignment_file\": \"frozen_fold_assignments.csv\"\n",
    "}\n",
    "\n",
    "with open(WORK / \"frozen_fold_metadata.json\", \"w\") as f:\n",
    "    json.dump(metadata, f, indent=2)\n",
    "\n",
    "print(\"Fixed outer folds created and saved.\\n\")\n",
    "print(\n",
    "    canonical.groupby([\"outer_fold\", \"label\"])\n",
    "    .size()\n",
    "    .unstack(fill_value=0)\n",
    "    .assign(total=lambda x: x.sum(axis=1))\n",
    ")\n",
    "print(f\"\\nGroups: {canonical['group_id'].nunique()}\")\n",
    "print(f\"Saved: {WORK / 'frozen_fold_assignments.csv'}\")"
  ],
  "metadata": {
    "id": "R2qmbuU8Rh3h"
  },
  "execution_count": null,
  "outputs": []
