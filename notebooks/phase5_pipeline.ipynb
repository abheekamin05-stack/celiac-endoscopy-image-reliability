  "cell_type": "code",
  "source": [
    "# Create frozen confidence, quality, instability, and combined scores\n",
    "\n",
    "import json\n",
    "import math\n",
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "\n",
    "WORK = Path(\"/content/celiac_reliability_phase5\")\n",
    "\n",
    "features = pd.read_csv(\n",
    "    WORK / \"frozen_reliability_features.csv\"\n",
    ")\n",
    "\n",
    "assert len(features) == 159\n",
    "assert features[\"file_id\"].is_unique\n",
    "\n",
    "# Only images predicted Normal are eligible for review ranking.\n",
    "predicted_normal = features.loc[\n",
    "    features[\"predicted_label\"] == \"Normal\"\n",
    "].copy()\n",
    "\n",
    "assert len(predicted_normal) > 0\n",
    "\n",
    "# Confidence priority:\n",
    "# lower p_normal means weaker confidence in the Normal prediction.\n",
    "predicted_normal[\n",
    "    \"confidence_priority_percentile\"\n",
    "] = (\n",
    "    1.0\n",
    "    - predicted_normal[\"p_normal\"].rank(\n",
    "        method=\"average\",\n",
    "        pct=True,\n",
    "        ascending=True,\n",
    "    )\n",
    ")\n",
    "\n",
    "# Instability priority:\n",
    "# larger probability changes mean greater instability.\n",
    "predicted_normal[\n",
    "    \"instability_percentile\"\n",
    "] = predicted_normal[\n",
    "    \"instability_mean_abs_change\"\n",
    "].rank(\n",
    "    method=\"average\",\n",
    "    pct=True,\n",
    "    ascending=True,\n",
    ")\n",
    "\n",
    "# Quality priority:\n",
    "# larger values indicate poorer technical quality.\n",
    "quality_columns = [\n",
    "    \"blur_proxy\",\n",
    "    \"extreme_exposure_fraction\",\n",
    "    \"glare_fraction\",\n",
    "]\n",
    "\n",
    "quality_percentile_columns = []\n",
    "\n",
    "for column in quality_columns:\n",
    "\n",
    "    percentile_column = (\n",
    "        f\"{column}_percentile\"\n",
    "    )\n",
    "\n",
    "    predicted_normal[\n",
    "        percentile_column\n",
    "    ] = predicted_normal[column].rank(\n",
    "        method=\"average\",\n",
    "        pct=True,\n",
    "        ascending=True,\n",
    "    )\n",
    "\n",
    "    quality_percentile_columns.append(\n",
    "        percentile_column\n",
    "    )\n",
    "\n",
    "predicted_normal[\n",
    "    \"technical_quality_percentile\"\n",
    "] = predicted_normal[\n",
    "    quality_percentile_columns\n",
    "].mean(axis=1)\n",
    "\n",
    "# Equal-weight combined priority.\n",
    "predicted_normal[\n",
    "    \"combined_review_priority\"\n",
    "] = predicted_normal[\n",
    "    [\n",
    "        \"confidence_priority_percentile\",\n",
    "        \"instability_percentile\",\n",
    "        \"technical_quality_percentile\",\n",
    "    ]\n",
    "].mean(axis=1)\n",
    "\n",
    "# Deterministic ranking with file_id as the tie-breaker.\n",
    "confidence_order = predicted_normal.sort_values(\n",
    "    [\n",
    "        \"confidence_priority_percentile\",\n",
    "        \"file_id\",\n",
    "    ],\n",
    "    ascending=[False, True],\n",
    "    kind=\"mergesort\",\n",
    ").index\n",
    "\n",
    "combined_order = predicted_normal.sort_values(\n",
    "    [\n",
    "        \"combined_review_priority\",\n",
    "        \"file_id\",\n",
    "    ],\n",
    "    ascending=[False, True],\n",
    "    kind=\"mergesort\",\n",
    ").index\n",
    "\n",
    "predicted_normal[\n",
    "    \"confidence_priority_rank\"\n",
    "] = np.nan\n",
    "\n",
    "predicted_normal.loc[\n",
    "    confidence_order,\n",
    "    \"confidence_priority_rank\",\n",
    "] = np.arange(\n",
    "    1,\n",
    "    len(predicted_normal) + 1,\n",
    ")\n",
    "\n",
    "predicted_normal[\n",
    "    \"combined_review_priority_rank\"\n",
    "] = np.nan\n",
    "\n",
    "predicted_normal.loc[\n",
    "    combined_order,\n",
    "    \"combined_review_priority_rank\",\n",
    "] = np.arange(\n",
    "    1,\n",
    "    len(predicted_normal) + 1,\n",
    ")\n",
    "\n",
    "N = len(predicted_normal)\n",
    "K_20 = math.ceil(0.20 * N)\n",
    "\n",
    "predicted_normal[\n",
    "    \"primary_review_rate\"\n",
    "] = 0.20\n",
    "\n",
    "predicted_normal[\n",
    "    \"primary_review_count_K\"\n",
    "] = K_20\n",
    "\n",
    "predicted_normal = (\n",
    "    predicted_normal\n",
    "    .sort_values(\"file_id\")\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "predicted_normal.to_csv(\n",
    "    WORK / \"frozen_review_scores_predicted_normal.csv\",\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "score_metadata = {\n",
    "    \"n_predicted_normal\": int(N),\n",
    "    \"primary_review_rate\": 0.20,\n",
    "    \"primary_review_count_K\": int(K_20),\n",
    "    \"confidence_weight\": 1 / 3,\n",
    "    \"instability_weight\": 1 / 3,\n",
    "    \"technical_quality_weight\": 1 / 3,\n",
    "    \"technical_quality_components\": quality_columns,\n",
    "    \"tie_rule\": \"file_id ascending\",\n",
    "    \"labels_used_to_construct_scores\": False,\n",
    "}\n",
    "\n",
    "with open(\n",
    "    WORK / \"frozen_score_metadata.json\",\n",
    "    \"w\",\n",
    ") as file:\n",
    "    json.dump(score_metadata, file, indent=2)\n",
    "\n",
    "print(\"Frozen review scores created.\")\n",
    "print(f\"Predicted-Normal images: {N}\")\n",
    "print(f\"Primary review count K: {K_20}\")\n",
    "print(\n",
    "    \"Saved:\",\n",
    "    WORK / \"frozen_review_scores_predicted_normal.csv\",\n",
    ")"
